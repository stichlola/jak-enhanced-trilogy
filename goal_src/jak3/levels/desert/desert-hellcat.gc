;;-*-Lisp-*-
(in-package goal)

;; name: desert-hellcat.gc
;; name in dgo: desert-hellcat
;; dgos: DESHCAT

;; Enhanced: the deshcat level (the Hellcat in the desert, see deshcat.gd). It's the Hellcat Jak flies
;; in the War Factory's sky battle (the factory-sky-battle task): h-warf, with its handling, its guns
;; (r1 gun-warf-shot, homing on what's ahead; l1 the warf-projectile missile, 8 of them, one back every
;; 20 s), its thrusters and its sounds (factory2). Once deshcat is in, vehicle type h-warf can be spawned
;; there: enhanced-hellcat-update (logic-target.gc) parks one near desert-start. Every Hellcat goes
;; before the level's code does.
;;
;; The factory's arena isn't the desert, so a few things change here, in deshcat's copy of h-warf only
;; (LFACTORY.DGO loads its own):
;; - the mission's altitudes are absolute (it flies between 314 and 480 m over the factory, it can't
;;   go lower and climbs no higher than ~430 m): here they're the same band over the ground under it;
;; - its arena (290 m around the factory, it's steered back in) isn't there;
;; - Jak can get out (triangle), the mission never lets him; the empty Hellcat comes down to the
;;   ground instead of hanging in the air, and doesn't blow itself up for standing still there;
;; - it takes off with the mission's start, a second at 50 m/s, when Jak gets in, not when it's parked.

(define-extern *enhanced-hellcat-shots* int) ;; logic-target.gc, counted for the test boot
(define-extern *enhanced-hellcat-missiles* int)
(define-extern *enhanced-hellcat-ground* float)
(define-extern enhanced-probe-line (function vector vector float float))

;; the factory's hud count of l1 shots (factory-manager.gc, not here)
(defun factory-shotsleft ((arg0 int))
  0
  (none)
  )

;; the missile's blast sphere, as warf-projectile.gc's but in deshcat (it's factoryb's there, and a
;; process-drawable with no level crashes). Its hemisplosion art isn't drawn here (its textures are
;; factoryb's), so the KG bombs' explosion (group-kg-explosion, GAME's enemy-part.gc) goes off with it.
(defbehavior warf-explosion-sphere-init-by-other warf-explosion-sphere ((arg0 warf-explosion-sphere-init-params))
  (vector-copy! (-> *launch-matrix* trans) (-> arg0 pos))
  (part-tracker-spawn part-tracker :to *entity-pool* :group (-> *part-group-id-table* 219))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self level) (level-get *level* 'deshcat))
  (initialize-skeleton
    self
    (the-as
      skeleton-group
      (art-group-get-by-name *level* "skel-warf-explosion-sphere" (the-as (pointer level) #f))
      )
    (the-as pair 0)
    )
  (vector-copy! (-> self root trans) (-> arg0 pos))
  (quaternion-identity! (-> self root quat))
  (set! (-> self draw lod-set lod 0 dist) 14336000.0)
  (set! (-> self expanding?) #t)
  (go-virtual active)
  )

;; The missile's trail and muzzle flash: GAME's copies of its parts (logic-target.gc), 5452 for the
;; muzzle flash 2896, group 1690 for group-factory-vehicle-shot (2905-2908 as 5453-5456). Its 2D
;; sprites, as the thrusters' (draw-thrusters below), drew nothing here: a glow (5461) and a 3D streak
;; (5462) show where it is.
(defmethod init-proj-settings! ((this warf-projectile))
  (set! (-> this hit-actor?) #f)
  (set! (-> this hit-pos quad) (the-as uint128 0))
  (vector-copy! (-> this tail-pos) (-> this root trans))
  (set! (-> this attack-mode) 'guard-shot)
  (set! (-> this max-speed) 327680.0)
  (set! (-> this move) warf-projectile-move)
  (logior! (-> this options) (projectile-options po13))
  (set! (-> this muzzle-flash-part) (the-as sparticle-launch-control (-> *part-id-table* 5452)))
  (set! (-> this part) (create-launch-control (-> *part-group-id-table* 1690) this))
  (let* ((v1-12 *game-info*)
         (a0-6 (+ (-> v1-12 attack-id) 1))
         )
    (set! (-> v1-12 attack-id) a0-6)
    (set! (-> this attack-id) a0-6)
    )
  0
  (none)
  )

(defmethod warf-projectile-method-42 ((this warf-projectile) (arg0 vector))
  (let ((speed (vector-length (-> this root transv))))
    (set! (-> *part-id-table* 5453 init-specs 12 initial-valuef) speed)
    (set! (-> *part-id-table* 5454 init-specs 12 initial-valuef) speed)
    (set! (-> *part-id-table* 5455 init-specs 14 initial-valuef) speed)
    (set! (-> *part-id-table* 5456 init-specs 14 initial-valuef) speed)
    )
  (spawn (-> this part) arg0)
  ;; the glow on it and the streak behind it
  (launch-particles (-> *part-id-table* 5461) (-> this root trans))
  (let ((back (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> this root transv) (meters -14)))
        (from (new 'stack-no-clear 'vector))
        )
    (vector+! from (-> this root trans) back)
    (vector-negate! back back)
    (draw-beam (-> *part-id-table* 5462) from back #f)
    )
  0
  (none)
  )

;; Jak may get out (vehicle flag #x400 keeps him in, in the mission)
(set! (-> *h-warf-constants* flags) (logclear (-> *h-warf-constants* flags) #x400))

;; The altitude band: the mission's floor is 314 m (its descent fades out there, h-warf's minalt) and
;; its ceiling 480 m (maxalt; climbing fades out from 400 m). Here the floor is 8 m over the ground.
(defconstant H_WARF_FLOOR (meters 314.5)) ;; *h-warf-constants*' minalt (1288192)
(defconstant H_WARF_ROOF (meters 165.5)) ;; maxalt over it
(defconstant ENHANCED_WARF_CLEARANCE (meters 8))

(define *enhanced-warf-shift* 0.0) ;; how far below the factory's the desert floor is, under the Hellcat

(define *enhanced-warf-ascention* ascention-atten!)

(defun ascention-atten! ((arg0 float))
  "As the factory's, for heights over the ground under the Hellcat."
  (*enhanced-warf-ascention* (- arg0 *enhanced-warf-shift*))
  )

(defun enhanced-warf-floor ((this h-warf))
  "The ground under the Hellcat, every few frames, and the mission's altitudes put over it."
  (when (zero? (logand (-> *display* base-clock integral-frame-counter) 3))
    (let ((from (new 'stack-no-clear 'vector))
          (to (new 'stack-no-clear 'vector))
          )
      (vector-copy! from (-> this root trans))
      (vector-copy! to from)
      (set! (-> to y) (- (-> from y) (meters 600)))
      (let ((u (enhanced-probe-line from to (meters 1))))
        (if (>= u 0.0)
            (set! *enhanced-hellcat-ground* (- (-> from y) (* u (meters 600))))
            )
        )
      )
    )
  (let ((floor (+ *enhanced-hellcat-ground* ENHANCED_WARF_CLEARANCE)))
    (set! *enhanced-warf-shift* (- floor H_WARF_FLOOR))
    ;; minalt pushes it up hard and kills it flying backwards below: only a guard just over the ground
    (set! (-> this minalt) (+ *enhanced-hellcat-ground* (meters 1)))
    (set! (-> this maxalt) (+ floor H_WARF_ROOF))
    )
  ;; no arena: its centre always just by it
  (set! (-> *h-warf-center-of-level* x) (+ (-> this root trans x) (meters 1)))
  (set! (-> *h-warf-center-of-level* z) (-> this root trans z))
  (none)
  )

(define *enhanced-warf-gravity* (the-as (function h-warf float none) (method-of-type h-warf apply-gravity!)))

;; Landing (circle, a free button on the Hellcat): it stops and comes down level to the ground with Jak
;; still in it, and rests there hovering as it does parked; x (throttle) or the stick pulled back
;; takes off again, with the mission's start. Meanwhile it flies as the empty one does: none of the
;; mission's thrust (it never goes slower than 37.5 m/s) nor its pitch along a dive.
(define *enhanced-warf-landing* #f)
(define *enhanced-warf-landing-time* 0)
(define *enhanced-warf-landed* #f) ;; logged once it's down
(define-extern enhanced-warf-landing-control (function h-warf none))

(defmethod apply-gravity! ((this h-warf) (arg0 float))
  (enhanced-warf-floor this)
  (let* ((riding? (logtest? (-> this v-flags) (vehicle-flag riding)))
         (landing? (and riding? *enhanced-warf-landing*))
         )
    (if (or (not riding?) landing?)
        ;; (no take-off while it's parked: see player-control)
        (set! (-> this birth) (- (current-time) (seconds 2)))
        )
    (if landing?
        (logclear! (-> this v-flags) (vehicle-flag riding))
        )
    (*enhanced-warf-gravity* this arg0)
    (if landing?
        (logior! (-> this v-flags) (vehicle-flag riding))
        )
    (when (or (not riding?) landing?)
      (let ((force (new 'stack-no-clear 'vector))
            (mass (-> this info info mass))
            (vel (-> this rbody lin-velocity))
            (height (- (-> this root trans y) *enhanced-hellcat-ground*))
            )
        (vector-reset! force)
        (cond
          ((or (not landing?) (< height (meters 4)))
           ;; empty (or landing, near the ground), it comes down to it, where its lift thrusters hold it
           ;; (the mission's never empty and gets no gravity of its own at low speed)
           (set! (-> force y) (* -1.0 mass (-> this info extra gravity)))
           )
          (else
            ;; landing, high up: down at half its height a second (1 to 25 m/s)
            (let ((want (- (fmax (meters 1) (fmin (meters 25) (* 0.5 height))))))
              (set! (-> force y) (* mass 3.0 (- want (-> vel y))))
              )
            )
          )
        (when landing?
          ;; and to a stop (within a couple of seconds; harder near the ground, or it slid down slopes)
          (let ((brake (if (< height (meters 4)) -6.0 -2.0)))
            (set! (-> force x) (* mass brake (-> vel x)))
            (set! (-> force z) (* mass brake (-> vel z)))
            )
          ;; and level: its own turn, not the mission's (which pitches it along its path and rolls it
          ;; into turns), brings its up to the world's within a moment, keeping a little of its yaw
          (let* ((rb (-> this rbody))
                 (it (-> rb info inertial-tensor))
                 (inertia (* 0.33333334 (+ (-> it rvec x) (-> it uvec y) (-> it fvec z))))
                 (want (vector-cross! (new 'stack-no-clear 'vector) (-> rb matrix uvec) *up-vector*))
                 )
            (vector-float*! want want 3.0)
            (set! (-> want y) (* 0.5 (-> rb ang-velocity y)))
            (vector-! want want (-> rb ang-velocity))
            (vector-float*! (-> rb torque) want (* 10.0 inertia))
            )
          (when (and (not *enhanced-warf-landed*) (< height (meters 3)) (< (vector-length vel) (meters 1)))
            (set! *enhanced-warf-landed* #t)
            (format 0 "[hellcat] landed by circle at ~M ground ~M~%" (-> this root trans y) *enhanced-hellcat-ground*)
            )
          )
        (add-force! (-> this rbody) force)
        )
      )
    )
  (none)
  )

(define *enhanced-warf-impact* (the-as (function h-warf rigid-body-impact none) (method-of-type h-warf on-impact)))

(defmethod on-impact ((this h-warf) (arg0 rigid-body-impact))
  ;; (the mission's blows the Hellcat up when it's stopped against something: not when it's parked)
  (if (and (logtest? (-> this v-flags) (vehicle-flag riding)) (not *enhanced-warf-landing*))
      (*enhanced-warf-impact* this arg0)
      ((method-of-type hvehicle on-impact) this arg0)
      )
  (none)
  )

(define *enhanced-warf-control* (the-as (function h-warf none) (method-of-type h-warf control-hook-player)))

(defmethod control-hook-player ((this h-warf))
  ;; the mission's, with its shots counted for the test boot
  (let ((shots (+ (-> this fire-time 0) (-> this fire-time 1) (-> this fire-time 2) (-> this fire-time 3)))
        (missile (-> this l1-fire-time))
        )
    (*enhanced-warf-control* this)
    (enhanced-warf-landing-control this)
    (if (!= shots (+ (-> this fire-time 0) (-> this fire-time 1) (-> this fire-time 2) (-> this fire-time 3)))
        (+! *enhanced-hellcat-shots* 1)
        )
    (when (!= missile (-> this l1-fire-time))
      (+! *enhanced-hellcat-missiles* 1)
      (format 0 "[hellcat] missile, ~D left~%" (-> this bigshotcount))
      )
    )
  (none)
  )

(defun enhanced-warf-landing-control ((this h-warf))
  "Circle starts landing; x or the stick pulled back, a moment later, takes off again."
  (cond
    ((not *enhanced-warf-landing*)
     (when (cpad-pressed? 0 circle)
       (set! *enhanced-warf-landing* #t)
       (set! *enhanced-warf-landed* #f)
       (set! *enhanced-warf-landing-time* (current-time))
       (format 0 "[hellcat] landing from ~M over the ground~%" (- (-> this root trans y) *enhanced-hellcat-ground*))
       )
     )
    ((and (time-elapsed? *enhanced-warf-landing-time* (seconds 0.5))
          (or (cpad-hold? 0 x) (< 200 (-> *cpad-list* cpads 0 lefty)))
          )
     (set! *enhanced-warf-landing* #f)
     ;; the mission's start: a second at 50 m/s
     (set-time! (-> this birth))
     (format 0 "[hellcat] take-off (engine loop id ~D)~%" (-> this engine-sound))
     )
    )
  (none)
  )

;; The thruster flames: h-warf's draw-thrusters as it is, but with its two parts (fac-part.gc's 2761 and
;; 2762) as GAME's copies 5450 and 5451 (logic-target.gc): as 2D sprites they drew nothing here. The
;; flame is a 3D sprite facing back along the exhaust (its specs one place on: a birth-func), the
;; blue around it a glow.
(defmethod draw-thrusters ((this h-warf) (arg0 float) (arg1 vector) (arg2 vector))
  (when (not (logtest? (-> this v-flags) (vehicle-flag dead)))
    (let ((flame (-> *part-id-table* 5450))
          (glow (-> *part-id-table* 5451))
          (s5-0 (new 'stack-no-clear 'vector))
          )
      (vector-copy! s5-0 arg2)
      (let ((s4-0 (new 'stack-no-clear 'matrix)))
        (quaternion->matrix s4-0 (-> this root quat))
        (let ((a2-1 (matrix-transpose! (new 'stack-no-clear 'matrix) s4-0)))
          (vector-rotate*! (-> this langvel) (-> this rbody ang-velocity) a2-1)
          )
        (cond
          ((not (-> this bounce-state?))
           (vector-rotate-around-axis! s5-0 arg2 (* -2184.5334 (-> this langvel x)) (-> s4-0 rvec))
           (vector-rotate-around-axis! s5-0 s5-0 (* -1820.4445 (-> this langvel y)) (-> s4-0 uvec))
           (vector-rotate-around-axis! s5-0 s5-0 (* 182.04445 (-> this langvel z) (* 5.0 arg0)) (-> s4-0 rvec))
           )
          (else
            (vector-copy! s5-0 arg2)
            )
          )
        (vector-copy! (-> s4-0 trans) arg1)
        ;; (a 3D sprite lies across its y: that along the exhaust; launched from *launch-matrix*, unturned)
        (forward-up->quaternion *particle-quat* (-> s4-0 uvec) s5-0)
        (dotimes (s3-1 15)
          (let* ((f28-0 (* 0.06666667 (- 15.0 (the float s3-1))))
                 (f26-0 (* f28-0 (rand-vu-float-range 8192.0 9011.2)))
                 (f30-0 (* f28-0 (rand-vu-float-range 8192.0 12288.0)))
                 )
            (vector+*! (-> s4-0 trans) (-> s4-0 trans) s5-0 (+ (* 819.2 f28-0) (* 1024.0 (-> this engine-thrust) f28-0)))
            (set! (-> flame init-specs 12 initial-valuef)
                  (+ (rand-vu-float-range 0.0 5.0) (* 60.0 f28-0 (-> this engine-thrust)) (* 40.0 f28-0))
                  )
            (set! (-> flame init-specs 9 initial-valuef) (+ (* 215.0 (-> this engine-thrust)) (* 40.0 f28-0)))
            (set! (-> flame init-specs 11 initial-valuef) (the float (- 255 (the int (* 255.0 (-> this engine-thrust))))))
            (set! (-> flame init-specs 4 initial-valuef) f26-0)
            (set! (-> flame init-specs 8 initial-valuef) f26-0)
            (set! (-> glow init-specs 4 initial-valuef) (* 255.0 f28-0 (-> this engine-thrust)))
            (set! (-> glow init-specs 5 initial-valuef)
                  (the float (- 28 (the int (* 28.0 f28-0 (-> this engine-thrust)))))
                  )
            (set! (-> glow init-specs 6 initial-valuef)
                  (the float (- 255 (the int (* 255.0 f28-0 (-> this engine-thrust)))))
                  )
            ;; (dimmer and smaller than the mission's, steadier too: at night their light pooled blue all
            ;; over the ground in front of the camera)
            (set! (-> glow init-specs 7 initial-valuef)
                  (* 0.45 (+ (rand-vu-float-range 0.0 (* 15.0 (-> this engine-thrust)))
                             (* 20.0 f28-0 (-> this engine-thrust))
                             (the float (* 30 (the int f28-0)))
                             )
                     )
                  )
            (set! (-> glow init-specs 2 initial-valuef) (* 0.7 f30-0))
            (set! (-> glow init-specs 3 initial-valuef) (* 0.7 f30-0))
            )
          (launch-particles :system *sp-particle-system-3d* flame (-> s4-0 trans))
          ;; (the blue glow around it every third step: glows are fewer than sprites can be)
          (if (zero? (mod s3-1 3))
              (launch-particles glow s4-0 :origin-is-matrix #t)
              )
          )
        )
      )
    )
  0
  (none)
  )

;; Its engine, boost and bank loops: h-warf's vehicle-method-106 (the sounds' stop, when it goes back to
;; waiting: parked, or Jak out) stops them and leaves their ids zero, and a loop played with id 0 never
;; sounds; the mission's Hellcat is never left, ours is parked first. They get new ids instead.
(define *enhanced-warf-sounds-off* (the-as (function h-warf none) (method-of-type h-warf vehicle-method-106)))

(defmethod vehicle-method-106 ((this h-warf))
  (*enhanced-warf-sounds-off* this)
  (if (zero? (-> this engine-sound))
      (set! (-> this engine-sound) (new-sound-id))
      )
  (if (zero? (-> this engine-boost-sound))
      (set! (-> this engine-boost-sound) (new-sound-id))
      )
  (if (zero? (-> this wind-noise-sound))
      (set! (-> this wind-noise-sound) (new-sound-id))
      )
  (none)
  )

;; its sounds (engine, boost, bank, guns, damage, explosion) are factory2's, in place of desert2's
;; (dflut, firetorch, cactus, waterfall sounds are out while flying)
(define *enhanced-hellcat-banks* '((desert2 factory2)))

(defstate player-control (h-warf)
  :virtual #t
  :enter (behavior ()
    (call-parent-state-handler enter)
    ;; the mission's start: a second at 50 m/s (apply-gravity!)
    (set-time! (-> self birth))
    (set! *enhanced-warf-landing* #f)
    (send-event *vehicle-manager* 'extra-bank *enhanced-hellcat-banks*)
    )
  :exit (behavior ()
    (set! *enhanced-warf-landing* #f)
    (send-event *vehicle-manager* 'no-extra-bank)
    (call-parent-state-handler exit)
    )
  )

(defun deshcat-activate ((arg0 level) (arg1 symbol))
  (set! (-> *traffic-info* vehicle-levels (vehicle-type h-warf)) (-> arg0 name))
  (format 0 "[hellcat] deshcat active, heap ~DK free~%"
          (/ (&- (-> arg0 heap top) (-> arg0 heap current)) 1024)
          )
  0
  (none)
  )

(defun deshcat-release ()
  "Jak out of the Hellcat and the Hellcat gone, with its shots and sounds: nothing of deshcat's may
outlive its code and art. enhanced-hellcat-update calls it before letting deshcat go, the level's
deactivate again."
  (when (and *target* (focus-test? *target* pilot))
    (let ((v (handle->process (-> *target* pilot vehicle))))
      (when (and v (type? v h-warf))
        (send-event *target* 'end-mode 'pilot)
        (send-event *vehicle-manager* 'no-extra-bank)
        )
      )
    )
  (let ((gp-0 (handle->process (-> *vehicle-info* handle-by-vehicle-type (vehicle-type h-warf)))))
    (when gp-0
      (format 0 "[hellcat] Hellcat gone~%")
      (deactivate gp-0)
      )
    )
  (set! (-> *vehicle-info* handle-by-vehicle-type (vehicle-type h-warf)) (the-as handle #f))
  (kill-by-type gun-warf-shot *active-pool*)
  (kill-by-type warf-projectile *active-pool*)
  (kill-by-type warf-explosion-sphere *active-pool*)
  0
  (none)
  )

(defun deshcat-deactivate ((arg0 level))
  (when (= (-> *traffic-info* vehicle-levels (vehicle-type h-warf)) (-> arg0 name))
    (set! (-> *traffic-info* vehicle-levels (vehicle-type h-warf)) #f)
    )
  (deshcat-release)
  (format 0 "[hellcat] deshcat out~%")
  0
  (none)
  )

(defun deshcat-hellcat ()
  "The Hellcat (h-warf) if there's one."
  (handle->process (-> *vehicle-info* handle-by-vehicle-type (vehicle-type h-warf)))
  )
