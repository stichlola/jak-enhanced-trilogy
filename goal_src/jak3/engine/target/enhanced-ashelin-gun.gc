(defconstant group-enhanced-ashelin-shot-hit (-> *part-group-id-table* 1641))

(defpartgroup group-enhanced-ashelin-shot-hit
  :id 1641
  :duration (seconds 1)
  :flags (sp0)
  :bounds (static-bspherem 0 0 0 8)
  :parts ((sp-item 5375 :period (seconds 2) :length (seconds 0.017))
    (sp-item 5376 :fade-after (meters 100) :period (seconds 2) :length (seconds 0.017))
    (sp-item 5377 :period (seconds 2) :length (seconds 0.017))
    (sp-item 5378 :fade-after (meters 50) :falloff-to (meters 50) :period (seconds 2) :length (seconds 0.667))
    (sp-item 5379 :fade-after (meters 100) :falloff-to (meters 100) :period (seconds 2) :length (seconds 0.667))
    (sp-item 5379 :fade-after (meters 100) :falloff-to (meters 100) :period (seconds 2) :length (seconds 0.5))
    (sp-item 5379 :fade-after (meters 100) :falloff-to (meters 100) :period (seconds 2) :length (seconds 0.417))
    (sp-item 5379 :fade-after (meters 100) :falloff-to (meters 100) :period (seconds 2) :length (seconds 0.335))
    (sp-item 5379 :fade-after (meters 100) :falloff-to (meters 100) :period (seconds 2) :length (seconds 0.25))
    (sp-item 5379 :fade-after (meters 100) :falloff-to (meters 100) :period (seconds 2) :length (seconds 0.217))
    (sp-item 5379 :fade-after (meters 100) :falloff-to (meters 100) :period (seconds 2) :length (seconds 0.167))
    (sp-item 5379 :fade-after (meters 100) :falloff-to (meters 100) :period (seconds 2) :length (seconds 0.135))
    (sp-item 5379 :fade-after (meters 100) :falloff-to (meters 100) :period (seconds 2) :length (seconds 0.085))
    )
  )

