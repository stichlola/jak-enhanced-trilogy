;;-*-Lisp-*-
(in-package goal)

;; name: enhanced-ashelin-gun.gc
;; name in dgo: enhanced-ashelin-gun
;; dgos: GAME

;; Enhanced: Ashelin's own pistol while she is the player's model (enhanced-player.gc draws her).
;; Holstered by default (the gun joint sits on her right thigh, where her holster strap is). D-pad up takes
;; it out and puts it away (R1 also takes it out); R1 fires, held for a shot every 0.25 s. The shots look and
;; sound like the oasis AI's (ash-shot.gc: red beam and burst, ashelin-fire from DESERT4.SBK) but are Jak's
;; yellow blaster shots underneath (gun-yellow-shot, in GAME), owned by Jak's target, so enemies take them as
;; his: same damage, same reactions. They leave from her gun joint toward the nearest enemy (or crate) in
;; front of her, the way Jak's guns track, else straight ahead; standing, she turns toward it.
;; Her own clips (ashelin-ag) for the gun, standing: waiting-to-standing (takeout), standing-idle (aiming),
;; standing-fire (each shot), standing-to-waiting (putaway). Walking, running or jumping, her right arm takes
;; the aiming stance's pose over her own animation (or Jak's retargeted one) and turns toward what she aims
;; at. Unarmed, her own idle/walk/jog/run hold the gun up: her arms hang as Jak's do (retargeted), the right
;; one turned out a little so her hand clears the holster, the left one in a little.
;; Jak's own guns are off while she plays (want-to-gun?, target-gun.gc), so nothing changes for Jak.
;; Hooks in enhanced-player.gc: enhanced-ashelin-gun-init (her process's init), -animate (picks her
;; standing gun animations) and -post (her pose, the controls and the shots, after her bones are done).
;; JAK_ENHANCED_ASHELIN_GUN_TEST=1 (test boots): takes it out, fires standing, fires running, puts it away,
;; with [ashelin-gun] log lines.

;; her joints and animations (art-elts.gc, ashelin-ag)
(defconstant ASHELIN_GUN_RSHOULDER 10)
(defconstant ASHELIN_GUN_RHAND 12)
(defconstant ASHELIN_GUN_JOINT 22)
(defconstant ASHELIN_GUN_RTHIGH 18)
(defconstant ASHELIN_GUN_HEAD 6)
(defconstant ASHELIN_STANDING_FIRE 28)
(defconstant ASHELIN_STANDING_IDLE 29)
(defconstant ASHELIN_WAITING_TO_STANDING 27) ;; gun from her side up to aiming: the takeout
(defconstant ASHELIN_STANDING_TO_WAITING 30) ;; and back down: the putaway

(defun enhanced-ashelin-gun-anim? ((idx int))
  "One of her own gun clips (stance, shot, takeout, putaway)?"
  (and (>= idx ASHELIN_WAITING_TO_STANDING) (<= idx ASHELIN_STANDING_TO_WAITING))
  )

(deftype enhanced-ashelin-gun-state (structure)
  ((pid        int32)        ;; her enhanced-skin process (0: none)
   (out        symbol)       ;; the gun is out
   (blend      float)        ;; how much her right arm takes the aiming pose (0-1)
   (aim-weight float)        ;; how much the arm turns toward the aim point (0-1)
   (rest-weight float)       ;; how much the arm takes Jak's relaxed one (unarmed, 0-1)
   (idle-weight float)       ;; how much she takes the hand-made idle pose (standing unarmed, 0-1)
   (sound-bank symbol)       ;; her gun's sound bank asked for (desert4: ashelin-fire)
   (trans-anim int32)        ;; her takeout or putaway clip playing (standing), else -1
   (aimed      symbol)       ;; something to aim at
   (fire-time  time-frame)
   (test-frame int32)
   (aim-pos    vector :inline)    ;; where she aims (world)
   (aim-local  matrix 4 :inline)  ;; right shoulder, elbow, hand, gun in the aiming stance (to their parents)
   (holster    matrix :inline)    ;; the gun to her right thigh, holstered
   (before     matrix 64 :inline) ;; her bones before the arm is posed
   (rest-src   matrix 7 :inline)  ;; Jak's arm turns last seen in his plain stance (slots 0-6, world)
   (rest-src-ok symbol)           ;; rest-src holds them
   (test-state basic)             ;; JAK_ENHANCED_ASHELIN_GUN_TEST=idle: Jak's state last logged
   (ammo        int32)            ;; rounds left in the magazine (ASHELIN_GUN_MAGAZINE full)
   (reloading   symbol)           ;; reloading: no shots until reload-time + ASHELIN_GUN_RELOAD
   (reload-time time-frame)
   )
  )

;; her magazine: 20 rounds, then a reload (her art group has no reload clip: standing, she lowers the gun
;; with her putaway clip and brings it back up with her takeout; moving, only the pause), with the gun sounds
(defconstant ASHELIN_GUN_MAGAZINE 20)
(defconstant ASHELIN_GUN_RELOAD (seconds 1.1))

(define *enhanced-ashelin-gun* (new 'global 'enhanced-ashelin-gun-state))
(set! (-> *enhanced-ashelin-gun* pid) 0)
(set! (-> *enhanced-ashelin-gun* out) #f)

(define *enhanced-ashelin-gun-test-buf* (new 'global 'string 16 (the-as string #f)))
(define *enhanced-ashelin-gun-test* (pc-enhanced-getenv "JAK_ENHANCED_ASHELIN_GUN_TEST" *enhanced-ashelin-gun-test-buf* 16))

(defun enhanced-ashelin-gun-active? ()
  "Is Ashelin, with her own gun, the player's model now? (Jak's guns are off then: want-to-gun?)"
  (let ((p *enhanced-skin-proc*))
    (if (and p (nonzero? (-> *enhanced-ashelin-gun* pid)) (= (-> p pid) (-> *enhanced-ashelin-gun* pid)))
        #t
        #f
        )
    )
  )

(defun enhanced-character-gun-hud ()
  "The gun HUD (hud-gun, hud-classes.gc) for a character's own gun: the gun type whose icon slot shows it,
   0: Jak's guns as always. Ashelin's pistol, out: the red gun's second mode, hud-gunred-02a, whose
   picture is hers while she is played (game/assets/enhanced/hud/jak3/characters/characters.txt).
   (Another character's own gun: one more case here, and a line there.)"
  (cond
    ((and (enhanced-ashelin-gun-active?) (-> *enhanced-ashelin-gun* out))
     (the-as int (pickup-type gun-red-2))
     )
    ;; Sig's Peacemaker (Jak's gun-dark-1 underneath), out: the dark gun's first mode, hud-gunpurple-01a
    ((and *target* (enhanced-player-sig?) (focus-test? *target* gun))
     (the-as int (pickup-type gun-dark-1))
     )
    (else
      0
      )
    )
  )

(defun enhanced-character-gun-arrow ()
  "The one lit arrow of a character's own gun (*gun-arrow-table*, hud-classes.gc): its D-pad direction.
   Ashelin: up (red, level 1), Sig: right (dark, level 1)."
  (if (= (enhanced-character-gun-hud) (the-as int (pickup-type gun-dark-1)))
      19
      1
      )
  )

(defun enhanced-character-gun-ammo? ()
  "Does a character's own gun show its ammo? Sig's Peacemaker spends Jak's dark ammo; Ashelin's pistol its
   magazine."
  (let ((g (enhanced-character-gun-hud)))
    (or (= g (the-as int (pickup-type gun-dark-1))) (= g (the-as int (pickup-type gun-red-2))))
    )
  )

(defun enhanced-character-gun-ammo ()
  "The ammo count the gun HUD shows for a character's own gun: Ashelin's rounds left, Sig's Jak's dark ammo."
  (if (= (enhanced-character-gun-hud) (the-as int (pickup-type gun-red-2)))
      (-> *enhanced-ashelin-gun* ammo)
      (the int (-> *target* game gun-ammo (+ (gun->ammo (pickup-type gun-dark-1)) -15)))
      )
  )

(defun enhanced-character-gun-max-ammo ()
  "Its full count for the HUD (the shells and \"n/max\"): Ashelin's magazine, else 0 (the gun type's own)."
  (if (= (enhanced-character-gun-hud) (the-as int (pickup-type gun-red-2)))
      ASHELIN_GUN_MAGAZINE
      0
      )
  )

(defun enhanced-ashelin-gun-slot ((k int))
  "Her arms' joints this file poses: the right arm's and the gun's index in aim-local (0-3), the left
   arm's 4-6 (only for the unarmed rest pose), else -1."
  (case k
    ((10) 0)
    ((11) 1)
    ((12) 2)
    ((22) 3)
    ((7) 4)
    ((8) 5)
    ((9) 6)
    (else -1)
    )
  )

(defun enhanced-ashelin-gun-parent ((nodes cspace-array) (k int))
  "Joint k's parent (the gun goes with her right hand), or -1."
  (if (= k ASHELIN_GUN_JOINT)
      ASHELIN_GUN_RHAND
      (let ((cs (-> nodes data k))
            (stride (&- (the-as pointer (-> nodes data 1)) (the-as pointer (-> nodes data 0))))
            )
        (if (-> cs parent)
            (/ (&- (the-as pointer (-> cs parent)) (the-as pointer (-> nodes data 0))) stride)
            -1
            )
        )
      )
  )

(defbehavior enhanced-ashelin-gun-init enhanced-skin ()
  "Her process's init: is it Ashelin? Then the holster (from her bind pose) and the aiming stance's arm."
  (let ((st *enhanced-ashelin-gun*)
        (nodes (-> self node-list))
        (inv (new 'stack-no-clear 'matrix))
        )
    (set! (-> st pid) 0)
    (when (and (string= (-> self draw art-group name) "ashelin")
               (> (-> nodes length) ASHELIN_GUN_JOINT)
               (> (-> self draw art-group length) ASHELIN_STANDING_IDLE)
               )
      (set! (-> st pid) (-> self pid))
      (set! (-> st out) #f)
      (set! (-> st blend) 0.0)
      (set! (-> st aim-weight) 0.0)
      (set! (-> st rest-weight) 1.0)
      (set! (-> st idle-weight) 0.0)
      (set! (-> st sound-bank) #f)
      (set! (-> st trans-anim) -1)
      (set! (-> st aimed) #f)
      (set! (-> st fire-time) 0)
      (set! (-> st ammo) ASHELIN_GUN_MAGAZINE)
      (set! (-> st reloading) #f)
      (set! (-> st reload-time) 0)
      ;; holstered: the gun as far from her right thigh as in her bind pose (arms down, the gun at her side)
      (matrix-4x4-inverse! inv (-> self bind-world ASHELIN_GUN_RTHIGH))
      (matrix*! (-> st holster) (-> self bind-world ASHELIN_GUN_JOINT) inv)
      ;; the aiming stance, once: her bones at its first frame, the arm's joints to their parents
      (ja-channel-set! 1)
      (ja :group! (the-as art-joint-anim (-> self draw art-group data ASHELIN_STANDING_IDLE)) :num! min)
      (ja-post)
      (dotimes (k (min 64 (-> nodes length)))
        (let ((slot (enhanced-ashelin-gun-slot k))
              (p (enhanced-ashelin-gun-parent nodes k))
              )
          (when (and (>= slot 0) (< slot 4) (>= p 0))
            (matrix-4x4-inverse! inv (-> nodes data p bone transform))
            (matrix*! (-> st aim-local slot) (-> nodes data k bone transform) inv)
            )
          )
        )
      (format 0 "[ashelin-gun] ready (holstered)~%")
      )
    )
  (none)
  )

(defbehavior enhanced-ashelin-gun-animate enhanced-skin ()
  "Standing still, her own clips for the gun: taking it out (waiting-to-standing), putting it away
   (standing-to-waiting), the aiming stance, her shot just after firing. #t if it played one."
  (let ((st *enhanced-ashelin-gun*)
        (tgt (-> self parent 0))
        )
    (when (and (= (-> self pid) (-> st pid))
               (or (-> st out) (>= (-> st trans-anim) 0))
               (not (focus-test? tgt pilot in-air))
               (< (-> tgt control ctrl-xz-vel)
                  (if (enhanced-ashelin-gun-anim? (-> self anim)) (meters 0.6) (meters 0.3))
                  )
               )
      ;; the takeout or putaway clip once through, then on (reloading, the putaway holds its last frame)
      (when (and (>= (-> st trans-anim) 0)
                 (= (-> self anim) (-> st trans-anim))
                 (>= (ja-frame-num 0) (the float (+ -2 (ja-num-frames 0))))
                 (not (and (-> st reloading) (= (-> st trans-anim) ASHELIN_STANDING_TO_WAITING)))
                 )
        (set! (-> st trans-anim) -1)
        )
      (cond
        ((and (-> st reloading)
              (= (-> self anim) ASHELIN_STANDING_TO_WAITING)
              (>= (ja-frame-num 0) (the float (+ -2 (ja-num-frames 0))))
              )
         (ja :num! (identity (the float (+ -1 (ja-num-frames 0)))))
         #t
         )
        ((>= (-> st trans-anim) 0)
         (enhanced-skin-play (-> st trans-anim) 1.0 (seconds 0.1))
         #t
         )
        ((not (-> st out))
         #f
         )
        ((time-elapsed? (-> st fire-time) (seconds 0.45))
         (enhanced-skin-play ASHELIN_STANDING_IDLE 1.0 (seconds 0.15))
         #t
         )
        (else
          (enhanced-skin-play ASHELIN_STANDING_FIRE 1.0 (seconds 0.05))
          #t
          )
        )
      )
    )
  )


(defun enhanced-ashelin-gun-allowed? ((tgt target))
  "Can she have it out now? Not in vehicles, on the board, dead, hit and so on, nor where the game
   keeps guns away (the same tests as Jak's want-to-gun?)."
  (and (-> *setting-control* user-current gun)
       (not (focus-test? tgt dead hit board mech dark pilot pilot-riding flut tube grabbed teleporting turret indax))
       (not (logtest? (surface-flag gun-inactive gun-hide gun-off) (-> tgt control current-surface flags)))
       (not (logtest? (target-flags prevent-gun invisible) (-> tgt target-flags)))
       )
  )

(defbehavior enhanced-ashelin-gun-find enhanced-skin ((tgt target) (fwd vector) (angle float))
  "The nearest enemy (or crate) within 70 m around fwd (angle wide), the way Jak's guns find theirs, or #f."
  (let ((from (new 'stack-no-clear 'vector))
        (to (new 'stack-no-clear 'vector))
        (ctr (new 'stack-no-clear 'vector))
        (search (-> tgt focus-search))
        )
    (vector-copy! from (-> tgt control trans))
    (+! (-> from y) (meters 1.5))
    (vector+float*! from from fwd (meters -8))
    (vector+float*! to from fwd (meters 80))
    (vector-average! ctr from to)
    (set! (-> ctr w) (* 0.5 (vector-vector-distance from to)))
    (set! (-> search length) (fill-actor-list-for-box *actor-hash* ctr (-> search data) (-> search allocated-length)))
    (find-nearest-focusable
      search
      (-> tgt control trans)
      (meters 70)
      (search-info-flag crate attackable enemy cull-angle probe prefer-center)
      (the-as search-info-flag 26)
      fwd
      (-> self node-list data ASHELIN_GUN_HEAD bone transform trans)
      angle
      )
    )
  )

;; Her shots look like the oasis AI's (ash-shot.gc, DESOASIS only): a red beam, a red flash at the gun and
;; a red burst where they land. Its particles, copied under ids of their own (5371-5383, group 1641), since
;; that level's go with it when it unloads. The rest is Jak's yellow shot (damage, collision); the sounds are hers.
