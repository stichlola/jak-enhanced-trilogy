  :init-specs ((:scale-x (meters 3.5))
    (:scale-y :copy scale-x)
    (:scalevel-x (meters -0.0875))
    (:scalevel-y :copy scalevel-x)
    (:fade-b -6.4)
    )
  )


(deftype enhanced-ashelin-shot (gun-yellow-shot)
  ()
  )


(defmethod deal-damage! ((this enhanced-ashelin-shot) (arg0 process) (arg1 event-message-block))
  (let ((hit? ((method-of-type gun-yellow-shot deal-damage!) this arg0 arg1)))
    (if hit?
        (format 0 "[ashelin-gun] hit ~A~%" (-> arg0 name))
        )
    hit?
    )
  )

(defmethod play-impact-sound ((this enhanced-ashelin-shot) (arg0 projectile-options))
  "Her own gun's sounds, as the oasis AI's shot plays them (ash-shot.gc): ashelin-fire is in DESERT4.SBK,
   loaded while her gun is out (enhanced-ashelin-gun-post)."
  (cond
    ((zero? arg0)
     (sound-play "ashelin-fire")
     )
    ((= arg0 (projectile-options po0))
     (sound-play "ashelin-shot-hi")
     )
    )
  (none)
  )

(defmethod projectile-method-24 ((this enhanced-ashelin-shot))
  (draw-beam (-> *part-id-table* 5374) (-> this tail-pos) (-> this starting-dir) #f)
  0
  (none)
  )

(defmethod projectile-method-25 ((this enhanced-ashelin-shot))
  ;; Enhanced: the renderer's ribbon behind the shot, red
  (pc-enhanced-shot (the-as pointer (-> this root trans)) 1 (-> this pid))
  (let* ((v1-1 (-> this root trans))
         (a1-0 (-> this tail-pos))
         (s5-1 (vector-! (new 'stack-no-clear 'vector) v1-1 a1-0))
         (gp-1 (vector+*! (new 'stack-no-clear 'vector) a1-0 s5-1 0.8))
         )
    (let ((f30-0 (-> *part-id-table* 5371 init-specs 4 initial-valuef)))
      (set! (-> *part-id-table* 5371 init-specs 4 initial-valuef) (fmin f30-0 (vector-length s5-1)))
      (draw-beam (-> *part-id-table* 5371) a1-0 s5-1 #f)
      (set! (-> *part-id-table* 5371 init-specs 4 initial-valuef) f30-0)
      )
    (vector-normalize! s5-1 1.0)
    (launch-particles (-> *part-id-table* 5372) gp-1)
    (let ((f0-4 (vector-dot s5-1 (-> (camera-matrix) fvec))))
      (when (< 0.0 f0-4)
        (let ((f0-5 (square f0-4))
              (f30-1 (-> *part-id-table* 5373 init-specs 8 initial-valuef))
              (f28-0 (-> *part-id-table* 5373 init-specs 8 random-rangef))
              )
          (set! (-> *part-id-table* 5373 init-specs 8 initial-valuef) (* f30-1 f0-5))
          (set! (-> *part-id-table* 5373 init-specs 8 random-rangef) (* f28-0 f0-5))
          (launch-particles (-> *part-id-table* 5373) gp-1)
          (set! (-> *part-id-table* 5373 init-specs 8 initial-valuef) f30-1)
          (set! (-> *part-id-table* 5373 init-specs 8 random-rangef) f28-0)
          )
        )
      )
    )
  0
  (none)
  )

(defmethod projectile-method-26 ((this enhanced-ashelin-shot))
  ;; Enhanced: sparks and a mark in the renderer, red
  (pc-enhanced-shot (the-as pointer (-> this root trans)) 1 (if (-> this hit-actor?) -2 -1))
  (vector-copy! (-> *launch-matrix* trans) (-> this root trans))
  (if (logtest? (-> group-enhanced-ashelin-shot-hit flags) (sp-group-flag sp13))
      (part-tracker-spawn part-tracker-subsampler :to *entity-pool* :group group-enhanced-ashelin-shot-hit)
      (part-tracker-spawn part-tracker :to *entity-pool* :group group-enhanced-ashelin-shot-hit)
      )
  0
  (none)
  )

(defbehavior enhanced-ashelin-gun-fire enhanced-skin ((tgt target) (pos vector) (dir vector))
  "One shot (red, Jak's yellow shot underneath), from pos along dir, as if Jak fired it."
  (let ((params (new 'stack-no-clear 'projectile-init-by-other-params)))
    (set! (-> params ent) (-> tgt entity))
    (set! (-> params charge) 1.0)
    (set! (-> params options) (projectile-options po17))
    (logclear! (-> params options) (projectile-options po14 po15 po16))
    (vector-copy! (-> params pos) pos)
    (set! (-> params notify-handle) (the-as handle #f))
    (set! (-> params owner-handle) (process->handle tgt))
    (set! (-> params target-handle) (the-as handle #f))
    (set! (-> params target-pos quad) (the-as uint128 0))
    (set! (-> params ignore-handle) (process->handle tgt))
    (let* ((gi *game-info*)
           (id (+ (-> gi attack-id) 1))
           )
      (set! (-> gi attack-id) id)
      (set! (-> params attack-id) id)
      )
    (set! (-> params timeout) (seconds 4))
    (vector-normalize-copy! (-> params vel) dir 819200.0)
    (spawn-projectile enhanced-ashelin-shot params self *default-dead-pool*)
    )
  (none)
  )

;; Her unarmed idle as the user posed it by hand in Blender (out/ashelin-pose/ashelin_idle_pose.blend,
;; made on her idle0's first frame): for each joint changed there, its turn from idle0's first frame, in
;; its own frame (E transposed, rows: new local rows = these 3x3 times her animation's local rows), so
;; it goes on top of her idle (she still breathes). Made by ashpose.py from the .blend's bone dump and
;; ashelin-lod0.glb (game joint = glb joint + 1); chest, hips, both arms and three finger bones.
(defconstant ASHELIN_IDLE_TURNS 11)
(define *enhanced-ashelin-idle-joints* (new 'static 'array int32 11 4 7 8 9 10 11 12 13 31 34 35))
(define *enhanced-ashelin-idle-turns* (new 'static 'array float 99
  0.999764 0.003657 0.021398 -0.001221 0.993599 -0.112928 -0.021676 0.112877 0.993368  ;; 4 chest
  0.996841 0.067457 -0.041833 -0.077669 0.937679 -0.338705 0.016380 0.340882 0.939960  ;; 7 Lshoulder
  0.896304 0.385772 0.218675 -0.443412 0.785243 0.432174 -0.004991 -0.484323 0.874872  ;; 8 Lelbow
  0.900828 -0.429867 0.061072 0.429866 0.863223 -0.264699 0.061062 0.264698 0.962398  ;; 9 Lhand
  0.999856 -0.012281 0.011440 0.006302 0.906558 0.422015 -0.015561 -0.421881 0.906510  ;; 10 Rshoulder
  0.995121 0.009316 0.098178 -0.097423 -0.059405 0.993363 0.015119 -0.998086 -0.058201  ;; 11 Relbow
  0.982867 0.179750 -0.040737 -0.111036 0.753770 0.647508 0.147096 -0.631884 0.760821  ;; 12 Rhand
  0.999346 -0.036149 -0.000171 0.036146 0.999330 -0.005758 0.000379 0.005749 0.999983  ;; 13 hips
  0.995873 -0.089503 0.015047 0.090575 0.990676 -0.101773 -0.005797 0.102717 0.994694  ;; 31 LmiddleB
  0.998481 -0.011421 0.052524 0.029798 0.931281 -0.362741 -0.044889 0.363763 0.930334  ;; 34 RmiddleA
  0.998177 -0.033116 0.050454 0.049740 0.925011 -0.376663 -0.034184 0.378503 0.924971  ;; 35 RmiddleB
  ))

(defun enhanced-ashelin-idle-turn ((k int))
  "Joint k's row in *enhanced-ashelin-idle-turns*, -1: not posed."
  (let ((found -1))
    (dotimes (i ASHELIN_IDLE_TURNS)
      (if (= (-> *enhanced-ashelin-idle-joints* i) k)
          (set! found i)
          )
      )
    found
    )
  )

(defun enhanced-ashelin-idle-turn! ((local matrix) (row int) (wt float))
  "local (a joint to its parent) turned as the hand-made idle has it, by wt."
  (let ((m (new 'stack-no-clear 'matrix))
        (len (new 'stack-no-clear 'matrix))
        (e (+ (* row 9) 0))
        )
    (matrix-copy! m local)
    (dotimes (i 3)
      (dotimes (c 3)
        (set! (-> m vector i data c)
              (+ (* (-> *enhanced-ashelin-idle-turns* (+ e (* i 3) 0)) (-> local vector 0 data c))
                 (* (-> *enhanced-ashelin-idle-turns* (+ e (* i 3) 1)) (-> local vector 1 data c))
                 (* (-> *enhanced-ashelin-idle-turns* (+ e (* i 3) 2)) (-> local vector 2 data c))
                 )
              )
        )
      )
    (enhanced-matrix-blend-rows! local (matrix-copy! len local) m wt len)
    )
  local
  )

(defbehavior enhanced-ashelin-gun-pose enhanced-skin ((w float) (aim-w float) (rest-w float) (idle-w float))
  "Her arms over what her bones have now (what hangs from them following): by idle-w her hand-made
   idle (standing, unarmed: *enhanced-ashelin-idle-turns* on her idle0); by rest-w (moving, unarmed) Jak's
   relaxed arms (her own animations hold the gun up), upper arms at her sides, elbows bent; by w the aiming
   stance's right arm, then turned at the shoulder toward the aim point by aim-w (at most 70 degrees)."
  (set! rest-w (* rest-w (- 1.0 idle-w)))
  (let* ((st *enhanced-ashelin-gun*)
         (nodes (-> self node-list))
         (n (min 64 (-> nodes length)))
         (local (new 'stack-no-clear 'matrix))
         (inv (new 'stack-no-clear 'matrix))
         (mixed (new 'stack-no-clear 'matrix))
         (arm 0)
         (changed 0)
         ;; the rest pose's turns, per slot (0-2 right upper arm, forearm, hand; 4-6 the left ones)
         (q-rest (new 'stack-no-clear 'inline-array 'quaternion 7))
         ;; Jak in one of his long-idle variations (she just loops her own idle)
         (fidget (let ((s (-> self parent 0 state)))
                   (and s (or (= (-> s name) 'target-stance-ambient)
                              (= (-> s name) 'target-stance-look-around)
                              (= (-> s name) 'target-look-around)
                              )
                        )
                   )
                 )
         )
    (dotimes (k n)
      (matrix-copy! (-> st before k) (-> nodes data k bone transform))
      )
    ;; the rest pose's turns, from hanging straight down: sideways (toward her right, left shoulder to right
    ;; shoulder) and forward. Upper arms close to her sides (the right one a little out, over the holster),
    ;; elbows bent: forearms and hands forward and in, so her hands rest at the front of her thighs.
    (when (< 0.0 rest-w)
      (let ((right (vector-! (new 'stack-no-clear 'vector)
                             (-> st before ASHELIN_GUN_RSHOULDER trans)
                             (-> st before 7 trans)
                             )
                   )
            (fwd (new 'stack-no-clear 'vector))
            (down (new 'stack-no-clear 'vector))
            (to (new 'stack-no-clear 'vector))
            )
        (set! (-> right w) 0.0)
        (vector-flatten! right right *up-vector*)
        (vector-normalize! right 1.0)
        (vector-z-quaternion! fwd (-> self root quat))
        (set! (-> fwd w) 0.0)
        (vector-flatten! fwd fwd *up-vector*)
        (vector-normalize! fwd 1.0)
        (set-vector! down 0.0 -1.0 0.0 0.0)
        (dotimes (slot 7)
          (when (!= slot 3)
            (let ((side (case slot
                          ((0) (degrees 3))      ;; right upper arm: a little out (the holster)
                          ((1 2) (degrees -6))   ;; right forearm, hand: in, toward the thigh's front
                          ((4) (degrees 6))      ;; left upper arm: in, against her side
                          (else (degrees 16))    ;; left forearm, hand: in
                          )
                        )
                  ;; (Jak's forearms already reach forward: only a little more)
                  (ahead (if (or (= slot 0) (= slot 4)) (degrees 0) (degrees 8)))
                  )
              (vector-copy! to down)
              (vector+float*! to to right (tan side))
              (vector+float*! to to fwd (tan ahead))
              (vector-normalize! to 1.0)
              (quaternion-from-two-vectors-partial! (-> q-rest slot) down to rest-w)
              )
            )
          )
        )
      )
    (dotimes (k n)
      (let ((p (enhanced-ashelin-gun-parent nodes k))
            (slot (enhanced-ashelin-gun-slot k))
            )
        (when (and (> k 0) (>= p 0) (< p k))
          (cond
            ((>= slot 0)
             (matrix-4x4-inverse! inv (-> st before p))
             (matrix*! local (-> st before k) inv)
             (let ((row (enhanced-ashelin-idle-turn k)))
               (if (and (< 0.0 idle-w) (>= row 0))
                   (enhanced-ashelin-idle-turn! local row idle-w)
                   )
               )
             (let ((bone (-> nodes data k bone transform))
                   (jnodes (-> self parent 0 node-list))
                   ;; Jak's Rarm, Rforarm, sk_rhand for her 10, 11, 12; Larm, Lforarm, sk_lhand for 7, 8, 9
                   (j (if (< k ASHELIN_GUN_RSHOULDER) (+ k 10) (+ k 16)))
                   )
               ;; her own, where her parent is now
               (matrix*! bone local (-> nodes data p bone transform))
               ;; unarmed: Jak's relaxed right arm instead of her animation's (it holds a gun up),
               ;; turned as his is from his bind pose (as enhanced-skin-retarget does)
               (when (and (< 0.0 rest-w) (< k ASHELIN_GUN_JOINT) (< j (-> jnodes length)) (-> jnodes data j joint))
                 ;; no fidgets: while Jak plays his long-idle variations (ambient, looking around) her
                 ;; arms keep his plain stance's, as last seen
                 (cond
                   ((and fidget (-> st rest-src-ok))
                    (matrix-copy! inv (-> st rest-src slot))
                    )
                   (else
                     (matrix*! inv (-> jnodes data j joint bind-pose) (-> jnodes data j bone transform))
                     (when (not fidget)
                       (matrix-copy! (-> st rest-src slot) inv)
                       (if (= slot 6) (set! (-> st rest-src-ok) #t))
                       )
                     )
                   )
                 (matrix*! mixed (-> self bind-world k) inv)
                 (vector-copy! (-> mixed trans) (-> bone trans))
                 (dotimes (r 3)
                   (let ((w0 (-> mixed vector r w)))
                     (vector-orient-by-quat! (-> mixed vector r) (-> mixed vector r) (-> q-rest slot))
                     (set! (-> mixed vector r w) w0)
                     )
                   )
                 (enhanced-matrix-blend-rows! bone (matrix-copy! local bone) mixed rest-w local)
                 )
               ;; armed: the aiming stance's arm
               (when (and (< 0.0 w) (< slot 4))
                 (matrix*! mixed (-> st aim-local slot) (-> nodes data p bone transform))
                 (enhanced-matrix-blend-rows! bone (matrix-copy! local bone) mixed w local)
                 )
               )
             (set! changed (logior changed (ash 1 k)))
             (if (or (= k ASHELIN_GUN_RSHOULDER) (logtest? arm (ash 1 p)))
                 (set! arm (logior arm (ash 1 k)))
                 )
             )
            ;; the hand-made idle's other joints (chest, hips, fingers)
            ((and (< 0.0 idle-w) (>= (enhanced-ashelin-idle-turn k) 0))
             (matrix-4x4-inverse! inv (-> st before p))
             (matrix*! local (-> st before k) inv)
             (enhanced-ashelin-idle-turn! local (enhanced-ashelin-idle-turn k) idle-w)
             (matrix*! (-> nodes data k bone transform) local (-> nodes data p bone transform))
             (set! changed (logior changed (ash 1 k)))
             (if (logtest? arm (ash 1 p))
                 (set! arm (logior arm (ash 1 k)))
                 )
             )
            ((logtest? changed (ash 1 p))
             (matrix-4x4-inverse! inv (-> st before p))
             (matrix*! local (-> st before k) inv)
             (matrix*! (-> nodes data k bone transform) local (-> nodes data p bone transform))
             (set! changed (logior changed (ash 1 k)))
             (if (logtest? arm (ash 1 p))
                 (set! arm (logior arm (ash 1 k)))
                 )
             )
            )
          )
        )
      )
    ;; the arm (shoulder to gun) turned toward the aim point, about the shoulder
    (when (< 0.0 aim-w)
      (let* ((s (-> nodes data ASHELIN_GUN_RSHOULDER bone transform trans))
             (pivot (vector-copy! (new 'stack-no-clear 'vector) s))
             (d0 (vector-! (new 'stack-no-clear 'vector) (-> nodes data ASHELIN_GUN_JOINT bone transform trans) pivot))
             (d1 (vector-! (new 'stack-no-clear 'vector) (-> st aim-pos) pivot))
             (q (new 'stack-no-clear 'quaternion))
             (tmp (new 'stack-no-clear 'vector))
             )
        (set! (-> pivot w) 1.0)
        (set! (-> d0 w) 0.0)
        (set! (-> d1 w) 0.0)
        (vector-normalize! d0 1.0)
        (vector-normalize! d1 1.0)
        (when (< (vector-dot d0 d1) 0.9999)
          (quaternion-from-two-vectors-max-angle-partial! q d0 d1 (degrees 70) aim-w)
          (dotimes (k n)
            (when (logtest? arm (ash 1 k))
              (let ((m (-> nodes data k bone transform)))
                (dotimes (r 3)
                  (let ((w0 (-> m vector r w)))
                    (vector-orient-by-quat! (-> m vector r) (-> m vector r) q)
                    (set! (-> m vector r w) w0)
                    )
                  )
                (vector-! tmp (-> m trans) pivot)
                (set! (-> tmp w) 0.0)
                (vector-orient-by-quat! tmp tmp q)
                (vector+! (-> m trans) pivot tmp)
                (set! (-> m trans w) 1.0)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun enhanced-ashelin-gun-test-step ((tgt target))
  "JAK_ENHANCED_ASHELIN_GUN_TEST: unarmed run 6-9 s; 12 s in, the gun out; fire standing 14-18 s; run firing 20-23 s;
   stand 24 s, fire again 26-29 s; put away at 32 s."
  (let* ((st *enhanced-ashelin-gun*)
         (t (-> st test-frame))
         )
    (+! (-> st test-frame) 1)
    (if (= t 1)
        (set-ignore-controller-in-bg! *pc-settings* #t)
        )
    ;; =idle: hands off, her animation and Jak's state logged as they change (long idle: no fidgets)
    (when (string= *enhanced-ashelin-gun-test-buf* "idle")
      (when (!= (-> tgt state) (-> st test-state))
        (set! (-> st test-state) (-> tgt state))
        (format 0 "[ashelin-gun] idle test ~,,1f s: jak ~A, her anim ~D~%"
                (/ (the float t) 60.0) (if (-> tgt state) (-> tgt state name) 'none) (-> (the-as enhanced-skin *enhanced-skin-proc*) anim)
                )
        )
      (if (zero? (mod t 600))
          (format 0 "[ashelin-gun] idle test ~D s: her anim ~D~%" (/ t 60) (-> (the-as enhanced-skin *enhanced-skin-proc*) anim))
          )
      (return (the-as none 0))
      )
    (case t
      ((720) (set! *enhanced-pad-press* (pad-buttons up)) (format 0 "[ashelin-gun] test: d-pad up (take out)~%"))
      ((840) (format 0 "[ashelin-gun] test: fire standing~%"))
      ((1200) (format 0 "[ashelin-gun] test: run firing~%"))
      ((1440) (format 0 "[ashelin-gun] test: stand~%"))
      ((1560) (format 0 "[ashelin-gun] test: fire standing 2~%"))
      ((1920) (set! *enhanced-pad-press* (pad-buttons up)) (format 0 "[ashelin-gun] test: d-pad up (put away)~%"))
      ((2100) (format 0 "[ashelin-gun] test: done~%"))
      )
    (set! *enhanced-pad-hold* (if (or (and (>= t 840) (< t 1080)) (and (>= t 1200) (< t 1380)) (and (>= t 1560) (< t 1740)))
                                  (pad-buttons r1)
                                  (pad-buttons)
                                  )
          )
    ;; the camera turned around her at the start (to see her front, unarmed)
    (set! *enhanced-pad-rightx* -1)
    ;; a step toward the camera (she turns to face it: her front), then runs away from it
    (set! *enhanced-pad-lefty* (cond
                                 ((or (and (>= t 200) (< t 215)) (and (>= t 760) (< t 775))) 255)
                                 ((or (and (>= t 360) (< t 540)) (and (>= t 1200) (< t 1400))) 0)
                                 (else -1)
                                 )
          )
    )
  (none)
  )

(defbehavior enhanced-ashelin-gun-post enhanced-skin ()
  "Each frame after her bones are done (enhanced-skin-post): the controls, her arm and gun, the shots."
  (let ((st *enhanced-ashelin-gun*)
        (tgt (-> self parent 0))
        )
    (when (= (-> self pid) (-> st pid))
      (if *enhanced-ashelin-gun-test*
          (enhanced-ashelin-gun-test-step tgt)
          )
      ;; Jak's own gun stays away while she plays (and doesn't come out by itself when he's back)
      (when (nonzero? (-> tgt gun))
        (if (using-gun? tgt)
            (send-event tgt 'change-mode 'normal)
            )
        (set! (-> tgt gun using-gun-type) (pickup-type none))
        (set! (-> tgt gun latch?) #f)
        )
      (let* ((pad (-> tgt control cpad number))
             (allowed? (enhanced-ashelin-gun-allowed? tgt))
             (busy? (focus-test? tgt edge-grab pole under-water))
             (fire? (and allowed? (not busy?) (cpad-hold? pad r1)))
             )
        ;; d-pad up: out or away; R1 takes it out too
        (cond
          ((not allowed?)
           (when (-> st out)
             (set! (-> st out) #f)
             (set! (-> st trans-anim) -1)
             (format 0 "[ashelin-gun] put away (not allowed here)~%")
             )
           )
          ((cpad-pressed? pad up)
           (set! (-> st out) (not (-> st out)))
           (if (-> st out)
               (sound-play "gun-takeout")
               (sound-play "gun-putaway")
               )
           (format 0 "[ashelin-gun] ~A~%" (if (-> st out) "out" "put away"))
           ;; standing: her own clip for it
           (when (and (< (-> tgt control ctrl-xz-vel) (meters 0.6)) (not (focus-test? tgt in-air)))
             (set! (-> st trans-anim) (if (-> st out) ASHELIN_WAITING_TO_STANDING ASHELIN_STANDING_TO_WAITING))
             (set! (-> self anim) -1)
             )
           )
          ((and fire? (not (-> st out)))
           (set! (-> st out) #t)
           (sound-play "gun-takeout")
           (format 0 "[ashelin-gun] out (R1)~%")
           )
          )
        ;; the magazine: reloaded ASHELIN_GUN_RELOAD after the last round (standing: the gun back up)
        (when (and (-> st reloading) (time-elapsed? (-> st reload-time) ASHELIN_GUN_RELOAD))
          (set! (-> st reloading) #f)
          (set! (-> st ammo) ASHELIN_GUN_MAGAZINE)
          (when (-> st out)
            (sound-play "gun-takeout")
            (when (= (-> st trans-anim) ASHELIN_STANDING_TO_WAITING)
              (set! (-> st trans-anim) ASHELIN_WAITING_TO_STANDING)
              (set! (-> self anim) -1)
              )
            )
          (format 0 "[ashelin-gun] reloaded ~D~%" (-> st ammo))
          )
        (let* ((own-gun-anim? (enhanced-ashelin-gun-anim? (-> self anim)))
               ;; (reloading, the arm lets her own clip lower the gun)
               (arm-on? (and (-> st out) (not busy?) (not (-> st reloading))))
               (fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> tgt control quat)))
               (moving? (< (meters 0.6) (-> tgt control ctrl-xz-vel)))
               )
          (vector-flatten! fwd fwd (-> tgt control dynam gravity-normal))
          (vector-normalize! fwd 1.0)
          ;; the stance over her other animations, in 0.15 s
          (seek! (-> st blend) (if (and arm-on? (not own-gun-anim?)) 1.0 0.0) (* 6.7 (seconds-per-frame)))
          (seek! (-> st aim-weight) (if arm-on? 1.0 0.0) (* 5.0 (seconds-per-frame)))
          (seek! (-> st rest-weight) (if (or (-> st out) (>= (-> st trans-anim) 0)) 0.0 1.0) (* 5.0 (seconds-per-frame)))
          ;; standing unarmed in her own idle: the hand-made idle pose (moving: Jak's relaxed arms)
          (seek! (-> st idle-weight)
                 (if (and (not (-> st out)) (< (-> st trans-anim) 0) (= (-> self anim) (-> self char idle)))
                     (- 1.0 (-> self pose-blend))
                     0.0
                     )
                 (* 5.0 (seconds-per-frame))
                 )
          ;; her gun's sound (ashelin-fire) is in the oasis mission's bank, DESERT4.SBK (99 KB, smaller than
          ;; the mode banks Jak's guns, board and mech load the same way): asked for as the mode sound bank
          ;; while her gun is out (a setting of her process, gone with it)
          (when (!= (-> st sound-bank) (-> st out))
            (set! (-> st sound-bank) (-> st out))
            (if (-> st out)
                (add-setting! 'mode-sound-bank 'desert4 0.0 0)
                (remove-setting! 'mode-sound-bank)
                )
            )
          ;; what she aims at
          (set! (-> st aimed) #f)
          (when (-> st out)
            (let ((f (enhanced-ashelin-gun-find tgt fwd (if moving? (degrees 40) (degrees 75)))))
              (cond
                (f
                 (vector-copy! (-> st aim-pos) (get-trans f 3))
                 (set! (-> st aimed) #t)
                 ;; standing, she turns toward it (as Jak does with his guns)
                 (when (and (not moving?) fire? (logtest? (-> tgt control status) (collide-status on-surface)))
                   (forward-up-nopitch->quaternion
                     (-> tgt control dir-targ)
                     (vector-! (new 'stack-no-clear 'vector) (-> st aim-pos) (-> tgt control trans))
                     (-> tgt control dynam gravity-normal)
                     )
                   )
                 )
                (else
                  ;; straight ahead, level with her shoulder
                  (vector+float*! (-> st aim-pos)
                                  (-> self node-list data ASHELIN_GUN_RSHOULDER bone transform trans)
                                  fwd
                                  (meters 20)
                                  )
                  )
                )
              )
            )
          ;; her arm, then the gun: in her hand while out, else in the holster
          (if (or (< 0.0 (-> st blend)) (< 0.0 (-> st aim-weight)) (< 0.0 (-> st rest-weight)) (< 0.0 (-> st idle-weight)))
              (enhanced-ashelin-gun-pose (-> st blend) (if (-> st out) (-> st aim-weight) 0.0) (-> st rest-weight) (-> st idle-weight))
              )
          (when (and (not (-> st out)) (< (-> st trans-anim) 0))
            (matrix*! (-> self node-list data ASHELIN_GUN_JOINT bone transform)
                      (-> st holster)
                      (-> self node-list data ASHELIN_GUN_RTHIGH bone transform)
                      )
            )
          ;; fire: from the gun toward the aim point
          (when (and (-> st out) fire? (not (-> st reloading)) (> (-> st ammo) 0)
                     (time-elapsed? (-> st fire-time) (seconds 0.25)) (< 0.5 (-> st aim-weight))
                     )
            (let* ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> self node-list data ASHELIN_GUN_JOINT bone transform trans)))
                   (dir (if (-> st aimed)
                            (vector-! (new 'stack-no-clear 'vector) (-> st aim-pos) pos)
                            (vector-copy! (new 'stack-no-clear 'vector) fwd)
                            )
                        )
                   )
              (set! (-> pos w) 1.0)
              (set! (-> dir w) 0.0)
              (vector-normalize! dir 1.0)
              (vector+float*! pos pos dir (meters 0.3))
              (set-time! (-> st fire-time))
              ;; standing: her shot animation again from its start
              (if (not moving?)
                  (set! (-> self anim) -1)
                  )
              (enhanced-ashelin-gun-fire tgt pos dir)
              ;; one round less; the last one starts the reload
              (+! (-> st ammo) -1)
              (when (<= (-> st ammo) 0)
                (set! (-> st reloading) #t)
                (set-time! (-> st reload-time))
                (sound-play "gun-putaway")
                (when (and (not moving?) (logtest? (-> tgt control status) (collide-status on-surface)))
                  (set! (-> st trans-anim) ASHELIN_STANDING_TO_WAITING)
                  (set! (-> self anim) -1)
                  )
                (format 0 "[ashelin-gun] reload~%")
                )
              ;; how well her arm (shoulder to gun) points along the shot: 1.0 = exactly
              (let ((arm-dir (vector-! (new 'stack-no-clear 'vector)
                                       (-> self node-list data ASHELIN_GUN_JOINT bone transform trans)
                                       (-> self node-list data ASHELIN_GUN_RSHOULDER bone transform trans)
                                       )
                             )
                    )
                (set! (-> arm-dir w) 0.0)
                (vector-normalize! arm-dir 1.0)
                (format 0 "[ashelin-gun] fire ~A arm-along-shot ~,,2f ammo ~D~%"
                        (if (-> st aimed) "at target" "ahead") (vector-dot arm-dir dir) (-> st ammo))
                )
              )
            )
          )
        )
      )
    )
  (none)
  )
