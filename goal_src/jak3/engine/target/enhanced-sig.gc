;;-*-Lisp-*-
(in-package goal)

;; name: enhanced-sig.gc
;; name in dgo: enhanced-sig
;; dgos: GAME

;; Enhanced: Sig's own animations that the game streams from .STR files instead of keeping them in his art
;; group (sig-highres-ag has only his idles): his walk (the museum's, MU2ANIMS.STR "museum-2-anims") and his
;; parts of the cutscenes he is in (one art group per chunk of a cutscene, "sig-highres-<scene>" in it).
;; Each clip is loaded once into a buffer of its own (global heap) and kept there, not linked into his art
;; group: enhanced-player.gc plays it on Sig's process (enhanced-sig-animate).
;; JAK_ENHANCED_SIG_CLIP=<spool>:<part> (test boots): Sig loops that clip standing (to look at his cutscenes'
;; poses), with [sig-clip] log lines (its frame every half second).
;; His Peacemaker (the end of this file) is Jak's gun-dark-1 underneath (D-pad right, target-gun.gc: Jak's
;; shots, sounds and ammo), drawn as his NPC holds it: upright in his right hand like a staff, as in his
;; wasdoors idle (sig-highres-idle-wasdoors, Spargus' gate). Standing, he plays that idle; moving, his right
;; arm takes its pose over his walk (or Jak's run). Out and away, the gun goes between his back and his hand
;; in 0.3 s; charging and firing, his forearm and hand tip it forward along Jak's shot. Unarmed, standing,
;; he plays the same wasdoors idle with his right arm as its left one, mirrored; walking unarmed, his arms
;; swing less than his museum walk (and Jak's walk and run) have them.
;; JAK_ENHANCED_SIG_GUN_TEST=1 (test boots): idle front and side, a walk, out, firing standing and walking,
;; away, with [sig-gun] log lines ("[sig-gun] shot <name>": when to take a screenshot).

(deftype enhanced-sig-clip (basic)
  ((spool      string)               ;; the stream's name (its .STR file is made from it, ISONameFromAnimationName)
   (part       int32)                ;; its chunk
   (anim-name  string)               ;; Sig's animation in that chunk
   (buffer     external-art-buffer)  ;; its own, kept
   (anim       art-joint-anim)       ;; loaded, or #f
   (failed     symbol)
   )
  )

;; one buffer's size (a chunk of a cutscene is at most the game's own buffers', #x3dc00)
(defconstant ENHANCED_SIG_CLIP_SIZE #x3e000)

(defun enhanced-sig-clip-new ((spool string) (part int) (anim-name string))
  (let ((clip (new 'global 'enhanced-sig-clip)))
    (set! (-> clip spool) spool)
    (set! (-> clip part) part)
    (set! (-> clip anim-name) anim-name)
    (set! (-> clip buffer) #f)
    (set! (-> clip anim) #f)
    (set! (-> clip failed) #f)
    clip
    )
  )

(defun enhanced-sig-clip-update ((clip enhanced-sig-clip) (owner process))
  "Load the clip (call each frame until it's there): its own buffer, the chunk streamed into it, Sig's
   animation found in it. Its art group stays locked in the buffer (never linked: his art group has no slot
   for it). Returns the animation, or #f."
  (when (and (not (-> clip anim)) (not (-> clip failed)))
    (when (not (-> clip buffer))
      (let ((buf (new 'global 'external-art-buffer 9 (lambda ((arg0 external-art-buffer)) 0) #t))
            (mem (kmalloc global ENHANCED_SIG_CLIP_SIZE (kmalloc-flags) "heap"))
            )
        (set! (-> buf heap base) mem)
        (set! (-> buf heap current) mem)
        (set! (-> buf heap top-base) (&+ mem ENHANCED_SIG_CLIP_SIZE))
        (set! (-> buf heap top) (-> buf heap top-base))
        ;; locked: once loaded it stays as it is (no linking to his art group, no unloading)
        (set! (-> buf locked?) #t)
        (set! (-> clip buffer) buf)
        )
      )
    (let ((buf (-> clip buffer)))
      (if (or (not (name= (-> buf pending-load-file) (-> clip spool))) (!= (-> buf pending-load-file-part) (-> clip part)))
          (set-pending-file buf (-> clip spool) (-> clip part) (process->handle owner) -1.0)
          )
      (set! (-> buf pending-load-file-owner) (process->handle owner))
      (update buf)
      (case (file-status buf (-> clip spool) (-> clip part))
        (('locked 'active)
         (let ((ag (-> buf art-group)))
           (when ag
             (dotimes (i (-> ag length))
               (let ((a (-> ag data i)))
                 (if (and a (type? a art-joint-anim) (string= (-> a name) (-> clip anim-name)))
                     (set! (-> clip anim) (the-as art-joint-anim a))
                     )
                 )
               )
             )
           (format 0 "[enhanced-sig] ~A part ~D: ~A ~A~%" (-> clip spool) (-> clip part) (-> clip anim-name) (-> clip anim))
           (if (not (-> clip anim))
               (set! (-> clip failed) #t)
               )
           )
         )
        (('error)
         (format 0 "[enhanced-sig] ~A part ~D: not loaded~%" (-> clip spool) (-> clip part))
         (set! (-> clip failed) #t)
         )
        )
      )
    )
  (-> clip anim)
  )

;; JAK_ENHANCED_SIG_CLIP=<spool> (and JAK_ENHANCED_SIG_PART=<chunk>, else 0)
(define *enhanced-sig-view-buf* (new 'global 'string 64 (the-as string #f)))
(define *enhanced-sig-part-buf* (new 'global 'string 16 (the-as string #f)))
(define *enhanced-sig-view* (the-as enhanced-sig-clip #f))
(define *enhanced-sig-view-frames* 0)
(when (pc-enhanced-getenv "JAK_ENHANCED_SIG_CLIP" *enhanced-sig-view-buf* 64)
  (let ((name (new 'global 'string 80 (the-as string #f))))
    (if (string= *enhanced-sig-view-buf* "museum-2-anims")
        (format name "sig-highres-sig-walk")
        (format name "sig-highres-~S" *enhanced-sig-view-buf*)
        )
    (set! *enhanced-sig-view*
          (enhanced-sig-clip-new *enhanced-sig-view-buf*
                                 (if (pc-enhanced-getenv "JAK_ENHANCED_SIG_PART" *enhanced-sig-part-buf* 16)
                                     (string->int *enhanced-sig-part-buf*)
                                     0
                                     )
                                 name
                                 )
          )
    )
  )

(defbehavior enhanced-sig-view? enhanced-skin ()
  "Is Sig looping a clip to look at (JAK_ENHANCED_SIG_CLIP)?"
  (if (and *enhanced-sig-view* (string= (-> self char name) "sig")) #t #f)
  )

(defbehavior enhanced-sig-own? enhanced-skin ()
  "Is he on his own streamed clip (not Jak's pose)?"
  (enhanced-sig-view?)
  )

(defbehavior enhanced-skin-stream-update enhanced-skin ()
  "The character's streamed animation (its entry's stream-...): loaded once, then put in its art group's
   empty slot, where its walk... index finds it."
  (let ((ch (-> self char)))
    (when (and (-> ch stream-spool) (>= (-> ch stream-slot) 0))
      (if (not (-> ch stream-clip))
          (set! (-> ch stream-clip) (enhanced-sig-clip-new (-> ch stream-spool) (-> ch stream-part) (-> ch stream-anim)))
          )
      (let ((a (enhanced-sig-clip-update (the-as enhanced-sig-clip (-> ch stream-clip)) self))
            (ag (-> self draw art-group))
            )
        (when (and a (< (-> ch stream-slot) (-> ag length)) (not (-> ag data (-> ch stream-slot))))
          (set! (-> ag data (-> ch stream-slot)) a)
          (format 0 "[enhanced-sig] ~A in ~A's slot ~D~%" a (-> ch name) (-> ch stream-slot))
          )
        )
      )
    )
  (none)
  )

;; his joints and animations (sig-highres-ag, art-elts.gc)
(defconstant SIG_LSHOULDER 11)
(defconstant SIG_LELBOW 12)
(defconstant SIG_RSHOULDER 14)
(defconstant SIG_RELBOW 15)
(defconstant SIG_RHAND 16)
(defconstant SIG_GUN 26)
(defconstant SIG_BLAST 27)    ;; the Peacemaker's muzzle (child of the gun)
(defconstant SIG_IDLE_ARMED 4) ;; sig-highres-idle-wasdoors: the gun upright in his right hand
(defconstant SIG_IDLE_PLAIN 3) ;; sig-highres-idle: one frame only (a cutscene's base pose), arms hanging

;; His unarmed right arm. His plain idle is a single frame (nothing moves), so standing he plays the
;; wasdoors idle (his NPC's at Spargus' gate: wider stance, a weight shift) also unarmed; its right arm
;; holds the gun up, so unarmed his right arm and fingers take the plain idle's turns instead (joint to
;; parent, captured at init), carried by his wasdoors chest.
(deftype enhanced-sig-arms (structure)
  ((ok    symbol)
   (arm   uint8 80)           ;; per joint: hangs from his right shoulder (1, not the gun) or his left (2)
   (mirror int8 80)           ;; per right arm joint: its left twin (same place in the left arm's chain)
   (local matrix 80 :inline)  ;; the plain idle: joint to its parent
   )
  )

(defun enhanced-sig-mirror! ((dst matrix) (src matrix))
  "dst = src mirrored left to right (a joint to its parent). His rig's left and right joints are mirror
   images across x (plain idle: Lshoulder quaternion x y z w, Rshoulder x -y -z w): S src S, S = (-1 1 1)."
  (matrix-copy! dst src)
  (set! (-> dst vector 0 y) (- (-> dst vector 0 y)))
  (set! (-> dst vector 0 z) (- (-> dst vector 0 z)))
  (set! (-> dst vector 1 x) (- (-> dst vector 1 x)))
  (set! (-> dst vector 2 x) (- (-> dst vector 2 x)))
  (set! (-> dst trans x) (- (-> dst trans x)))
  dst
  )

(define *enhanced-sig-plain-arms* (new 'global 'enhanced-sig-arms))
(set! (-> *enhanced-sig-plain-arms* ok) #f)

(deftype enhanced-sig-gun-state (structure)
  ((pid         int32)              ;; his enhanced-skin process (0: none)
   (out-blend   float)              ;; the gun from his back (0) to his hand (1)
   (aim-weight  float)              ;; how much the gun tips forward along the shot (0-1)
   (rest-weight float)              ;; how much his arms take the rest turns (standing unarmed, 0-1)
   (was-out     symbol)             ;; for the log
   (test-frame  int32)
   (hold-local  matrix 4 :inline)   ;; the wasdoors idle: right shoulder, elbow, hand to their parents, the gun to his hand
   (blast-local matrix :inline)     ;; the muzzle to the gun
   (before      matrix 80 :inline)  ;; his bones before the arms are posed
   (moved       uint8 80)           ;; per joint: posed this frame
   (chain       uint8 80)           ;; per joint: hangs from the joint being turned
   )
  )

(define *enhanced-sig-gun* (new 'global 'enhanced-sig-gun-state))
(set! (-> *enhanced-sig-gun* pid) 0)

(define *enhanced-sig-gun-test-buf* (new 'global 'string 16 (the-as string #f)))
(define *enhanced-sig-gun-test* (pc-enhanced-getenv "JAK_ENHANCED_SIG_GUN_TEST" *enhanced-sig-gun-test-buf* 16))

(defbehavior enhanced-sig-gun-stand? enhanced-skin ()
  "Sig standing with his Peacemaker out: his wasdoors idle (his NPC's way of holding it)."
  (let ((st *enhanced-sig-gun*)
        (tgt (-> self parent 0))
        )
    (and (= (-> self pid) (-> st pid))
         (using-gun? tgt)
         (not (focus-test? tgt pilot in-air))
         (< (-> tgt control ctrl-xz-vel) (if (= (-> self anim) SIG_IDLE_ARMED) (meters 0.6) (meters 0.3)))
         )
    )
  )

(defbehavior enhanced-sig-animate enhanced-skin ()
  "Sig's streamed clips, and his wasdoors idle standing with his gun out. Returns #t when it picked his
   animation."
  (enhanced-skin-stream-update)
  (when (and (not (enhanced-sig-view?)) (enhanced-sig-gun-stand?))
    (enhanced-skin-play SIG_IDLE_ARMED 1.0 (seconds 0.15))
    (return #t)
    )
  (when (enhanced-sig-view?)
    (let* ((clip *enhanced-sig-view*)
           (a (enhanced-sig-clip-update clip self))
           )
      (cond
        ((and (not a) (-> clip failed))
         ;; past its last chunk: from the first again
         (when (> (-> clip part) 0)
           (set! (-> clip part) 0)
           (set! (-> clip failed) #f)
           )
         )
        ((and a (string= (-> clip spool) "museum-2-anims"))
         ;; his walk: looping
         (when (!= (-> self anim) 100)
           (set! (-> self anim) 100)
           (ja-channel-push! 1 0)
           (ja :group! a :num! min)
           )
         (ja :num! (loop!))
         )
        (a
          ;; a cutscene: each chunk's start, a third and two thirds in, held 1.5 s each, then the next
          ;; chunk ([sig-clip] show lines: when to look)
          (let* ((n (ja-num-frames 0))
                 (k (/ *enhanced-sig-view-frames* 90))
                 )
            (when (!= (-> self anim) 100)
              (set! (-> self anim) 100)
              (set! *enhanced-sig-view-frames* 0)
              (set! k 0)
              (ja-channel-set! 1)
              (ja :group! a :num! min)
              (set! n (ja-num-frames 0))
              )
            (cond
              ((>= k 3)
               ;; the next chunk (into the same buffer: off this one first, onto his idle)
               (+! (-> clip part) 1)
               (set! (-> clip anim) #f)
               (set! (-> self anim) -1)
               (ja-channel-set! 1)
               (ja :group! (-> self draw art-group data (-> self char idle)) :num! min)
               )
              (else
                (let ((f (the float (/ (* k (+ n -1)) 3))))
                  (ja :num-func num-func-identity :frame-num f)
                  (if (zero? (mod *enhanced-sig-view-frames* 90))
                      (format 0 "[sig-clip] show ~A part ~D frame ~f of ~D~%" (-> clip spool) (-> clip part) f n)
                      )
                  )
                )
              )
            (+! *enhanced-sig-view-frames* 1)
            )
          )
        )
      )
    #t
    )
  )

(defbehavior enhanced-sig-post enhanced-skin ()
  "After ja-post: a cutscene clip moves him around the scene; keep him where Jak is (his main joint over
   Jak's position)."
  (when (enhanced-sig-view?)
    (let* ((nodes (-> self node-list))
           (main (-> self char main))
           (d (vector-! (new 'stack-no-clear 'vector) (-> self root trans) (-> nodes data main bone position)))
           )
      ;; (and up or down so his main joint is as high over Jak's feet as in his bind pose)
      (+! (-> d y) (-> self bind-world main trans y))
      (set! (-> d w) 0.0)
      (if (zero? (mod *enhanced-sig-view-frames* 90))
          (format 0 "[sig-clip] moved by ~M ~M ~M~%" (-> d x) (-> d y) (-> d z))
          )
      (dotimes (k (-> nodes length))
        (vector+! (-> nodes data k bone transform trans) (-> nodes data k bone transform trans) d)
        )
      ;; (its bounds too, or it's culled where the scene had him)
      (let ((w (-> self draw origin w)))
        (vector+! (-> self draw origin) (-> self draw origin) d)
        (set! (-> self draw origin w) w)
        )
      )
    )
  (none)
  )

;; ---- his Peacemaker ----

(defun enhanced-sig-gun-parent ((nodes cspace-array) (k int))
  "Joint k's parent (the gun goes with his right hand), or -1."
  (if (= k SIG_GUN)
      SIG_RHAND
      (let ((cs (-> nodes data k))
            (stride (&- (the-as pointer (-> nodes data 1)) (the-as pointer (-> nodes data 0))))
            )
        (if (-> cs parent)
            (/ (&- (the-as pointer (-> cs parent)) (the-as pointer (-> nodes data 0))) stride)
            -1
            )
        )
      )
  )

(defun enhanced-sig-hold-slot ((k int))
  "The right arm's joints and the gun: their index in hold-local (0-3), else -1."
  (case k
    ((14) 0)
    ((15) 1)
    ((16) 2)
    ((26) 3)
    (else -1)
    )
  )

(defun enhanced-sig-rest-slot ((k int))
  "The rest pose's joints: right upper arm 0, right forearm 1, left upper arm 2, left forearm 3, else -1."
  (case k
    ((14) 0)
    ((15) 1)
    ((11) 2)
    ((12) 3)
    (else -1)
    )
  )

(defbehavior enhanced-sig-gun-init enhanced-skin ()
  "His process's init: is it Sig? Then his NPC's hold, once: the wasdoors idle's right arm and gun."
  (let ((st *enhanced-sig-gun*)
        (nodes (-> self node-list))
        (inv (new 'stack-no-clear 'matrix))
        )
    (set! (-> st pid) 0)
    (when (and (string= (-> self char name) "sig")
               (> (-> nodes length) SIG_BLAST)
               (> (-> self draw art-group length) SIG_IDLE_ARMED)
               (-> self draw art-group data SIG_IDLE_ARMED)
               )
      (set! (-> st pid) (-> self pid))
      (set! (-> st out-blend) 0.0)
      (set! (-> st aim-weight) 0.0)
      (set! (-> st rest-weight) 0.0)
      (set! (-> st was-out) #f)
      ;; the plain idle's right arm, for standing unarmed
      (let ((ra *enhanced-sig-plain-arms*))
        (set! (-> ra ok) #f)
        (when (-> self draw art-group data SIG_IDLE_PLAIN)
          (ja-channel-set! 1)
          (ja :group! (the-as art-joint-anim (-> self draw art-group data SIG_IDLE_PLAIN)) :num! min)
          (ja-post)
          (dotimes (k (min 80 (-> nodes length)))
            (set! (-> ra arm k) 0)
            (let ((p (enhanced-sig-gun-parent nodes k)))
              (when (and (> k 0) (!= k SIG_GUN) (>= p 0) (< p k)
                         (or (= k SIG_RSHOULDER) (= k SIG_LSHOULDER) (nonzero? (-> ra arm p)))
                         )
                (set! (-> ra arm k) (cond
                                      ((= k SIG_RSHOULDER) 1)
                                      ((= k SIG_LSHOULDER) 2)
                                      (else (-> ra arm p))
                                      )
                      )
                (matrix-4x4-inverse! inv (-> nodes data p bone transform))
                (matrix*! (-> ra local k) (-> nodes data k bone transform) inv)
                )
              )
            )
          ;; each right arm joint's left twin: the n-th of the right chain is the n-th of the left one
          (let ((li 0))
            (dotimes (k (min 80 (-> nodes length)))
              (set! (-> ra mirror k) -1)
              (when (= (-> ra arm k) 1)
                (let ((found -1)
                      (seen 0)
                      )
                  (dotimes (m (min 80 (-> nodes length)))
                    (when (= (-> ra arm m) 2)
                      (if (and (< found 0) (= seen li)) (set! found m))
                      (+! seen 1)
                      )
                    )
                  (set! (-> ra mirror k) found)
                  (+! li 1)
                  )
                )
              )
            )
          (set! (-> ra ok) #t)
          )
        )
      (ja-channel-set! 1)
      (ja :group! (the-as art-joint-anim (-> self draw art-group data SIG_IDLE_ARMED)) :num! min)
      (ja-post)
      (dotimes (k (min 80 (-> nodes length)))
        (let ((slot (enhanced-sig-hold-slot k))
              (p (enhanced-sig-gun-parent nodes k))
              )
          (when (and (>= slot 0) (>= p 0))
            (matrix-4x4-inverse! inv (-> nodes data p bone transform))
            (matrix*! (-> st hold-local slot) (-> nodes data k bone transform) inv)
            )
          )
        )
      (matrix-4x4-inverse! inv (-> nodes data SIG_GUN bone transform))
      (matrix*! (-> st blast-local) (-> nodes data SIG_BLAST bone transform) inv)
      ;; his fists for Jak's attacks (enhanced-skin-retarget): the fingers of his right hand as they grip
      ;; the gun in this idle, and the same mirrored for their left twins
      (let ((fx *enhanced-sig-arm-fix*)
            (ra *enhanced-sig-plain-arms*)
            (count 0)
            )
        (when (-> ra ok)
          (dotimes (k (min 80 (-> nodes length)))
            (let ((p (enhanced-sig-gun-parent nodes k)))
              (when (and (> k SIG_RHAND) (!= k SIG_GUN) (!= k SIG_BLAST) (>= p 0) (< p k)
                         (or (= p SIG_RHAND) (= (-> fx finger p) 1))
                         )
                (matrix-4x4-inverse! inv (-> nodes data p bone transform))
                (matrix*! (-> fx fist k) (-> nodes data k bone transform) inv)
                (set! (-> fx finger k) 1)
                (+! count 1)
                (let ((twin (-> ra mirror k)))
                  (when (and (>= twin 0) (< twin 80))
                    (enhanced-sig-mirror! (-> fx fist twin) (-> fx fist k))
                    (set! (-> fx finger twin) 2)
                    )
                  )
                )
              )
            )
          )
        (format 0 "[sig-gun] fists: ~D finger joints a hand~%" count)
        )
      (format 0 "[sig-gun] ready~%")
      )
    )
  (none)
  )

(defbehavior enhanced-sig-turn-tree! enhanced-skin ((j int) (q quaternion) (pivot vector))
  "Joint j and all that hangs from it (the gun with his right hand) turned by q about pivot."
  (let* ((st *enhanced-sig-gun*)
         (nodes (-> self node-list))
         (n (min 80 (-> nodes length)))
         (pv (vector-copy! (new 'stack-no-clear 'vector) pivot))
         (tmp (new 'stack-no-clear 'vector))
         )
    (set! (-> pv w) 1.0)
    (dotimes (k n)
      (let ((p (enhanced-sig-gun-parent nodes k)))
        (set! (-> st chain k) (if (or (= k j) (and (> k j) (>= p 0) (< p k) (nonzero? (-> st chain p)))) 1 0))
        )
      (when (nonzero? (-> st chain k))
        (let ((m (-> nodes data k bone transform)))
          (dotimes (r 3)
            (let ((w0 (-> m vector r w)))
              (vector-orient-by-quat! (-> m vector r) (-> m vector r) q)
              (set! (-> m vector r w) w0)
              )
            )
          (vector-! tmp (-> m trans) pv)
          (set! (-> tmp w) 0.0)
          (vector-orient-by-quat! tmp tmp q)
          (vector+! (-> m trans) pv tmp)
          (set! (-> m trans w) 1.0)
          )
        )
      )
    )
  (none)
  )

(defbehavior enhanced-sig-shift-tree! enhanced-skin ((j int) (d vector))
  "Joint j and all that hangs from it moved by d."
  (let* ((st *enhanced-sig-gun*)
         (nodes (-> self node-list))
         (n (min 80 (-> nodes length)))
         )
    (dotimes (k n)
      (let ((p (enhanced-sig-gun-parent nodes k)))
        (set! (-> st chain k) (if (or (= k j) (and (> k j) (>= p 0) (< p k) (nonzero? (-> st chain p)))) 1 0))
        )
      (when (nonzero? (-> st chain k))
        (let ((t (-> nodes data k bone transform trans)))
          (+! (-> t x) (-> d x))
          (+! (-> t y) (-> d y))
          (+! (-> t z) (-> d z))
          )
        )
      )
    )
  (none)
  )

(defun enhanced-sig-two-bone ((e vector) (s vector) (k vector) (target vector) (l1 float) (l2 float))
  "Two-bone IK: e = where the middle joint goes (root at s, end reaching toward target), bending the
   way k (the middle joint now) does. Returns how far the end can get (at most l1 + l2)."
  (let* ((dir (vector-! (new 'stack-no-clear 'vector) target s))
         (d (vector-length dir))
         (pole (vector-! (new 'stack-no-clear 'vector) k s))
         )
    (set! (-> dir w) 0.0)
    (set! (-> pole w) 0.0)
    (if (< 1.0 d)
        (vector-float*! dir dir (/ 1.0 d))
        (set-vector! dir 0.0 -1.0 0.0 0.0)
        )
    (set! d (fmax (* 0.05 (+ l1 l2)) (fmin d (* 0.999 (+ l1 l2)))))
    (let* ((along (/ (+ (- (* l1 l1) (* l2 l2)) (* d d)) (* 2.0 d)))
           (h (sqrtf (fmax 0.0 (- (* l1 l1) (* along along)))))
           )
      (vector+float*! pole pole dir (- (vector-dot pole dir)))
      (set! (-> pole w) 0.0)
      (if (< 1.0 (vector-length pole))
          (vector-normalize! pole 1.0)
          (vector-reset! pole)
          )
      (vector+float*! e s dir along)
      (vector+float*! e e pole h)
      (set! (-> e w) 1.0)
      )
    d
    )
  )

(defbehavior enhanced-sig-limb-ik! enhanced-skin ((j0 int) (j1 int) (j2 int) (root vector) (target vector) (keep-end symbol))
  "A limb (j0 upper, j1 middle, j2 end, each the parent of the next) put with j0 at root and j2 reaching
   target, bending as it does now; what hangs from each joint goes along. keep-end: j2 (and what hangs
   from it: toes, fingers, the gun) keeps its turn, else it turns with the bone above it."
  (let* ((nodes (-> self node-list))
         (rt (vector-copy! (new 'stack-no-clear 'vector) root))
         (tg (vector-copy! (new 'stack-no-clear 'vector) target))
         (d (vector-! (new 'stack-no-clear 'vector) root (-> nodes data j0 bone transform trans)))
         (s1 (-> nodes data j1 bone transform trans))
         (s2 (-> nodes data j2 bone transform trans))
         (e (new 'stack-no-clear 'vector))
         (end (new 'stack-no-clear 'vector))
         (from (new 'stack-no-clear 'vector))
         (to (new 'stack-no-clear 'vector))
         (pv (new 'stack-no-clear 'vector))
         (q1 (new 'stack-no-clear 'quaternion))
         (q2 (new 'stack-no-clear 'quaternion))
         )
    (set! (-> rt w) 1.0)
    (set! (-> d w) 0.0)
    ;; the limb's root where it belongs
    (enhanced-sig-shift-tree! j0 d)
    (let* ((l1 (vector-vector-distance rt s1))
           (l2 (vector-vector-distance s1 s2))
           (reach (enhanced-sig-two-bone e rt s1 tg l1 l2))
           )
      (vector-! end tg rt)
      (set! (-> end w) 0.0)
      (vector-normalize! end reach)
      (vector+! end end rt)
      (set! (-> end w) 1.0)
      )
    ;; the upper bone toward e
    (vector-! from s1 rt)
    (vector-! to e rt)
    (vector-normalize! from 1.0)
    (vector-normalize! to 1.0)
    (quaternion-from-two-vectors! q1 from to)
    (enhanced-sig-turn-tree! j0 q1 rt)
    ;; the middle bone toward the end
    (vector-copy! pv s1)
    (vector-! from s2 pv)
    (vector-! to end pv)
    (vector-normalize! from 1.0)
    (vector-normalize! to 1.0)
    (quaternion-from-two-vectors! q2 from to)
    (enhanced-sig-turn-tree! j1 q2 pv)
    ;; the end turned back as it was (undone in reverse order)
    (when keep-end
      (vector-copy! pv s2)
      (quaternion-conjugate! q2 q2)
      (enhanced-sig-turn-tree! j2 q2 pv)
      (quaternion-conjugate! q1 q1)
      (enhanced-sig-turn-tree! j2 q1 pv)
      )
    )
  (none)
  )

(define-extern enhanced-sig-attacking? (function target object))

;; his planted feet (left, right): where each ankle was put down (world xz), and how much it stays there
;; (0-1, in w); and whether Jak had that foot down last frame
(define *enhanced-sig-foot-lock-l* (new 'global 'vector))
(define *enhanced-sig-foot-lock-r* (new 'global 'vector))
(set! (-> *enhanced-sig-foot-lock-l* w) 0.0)
(set! (-> *enhanced-sig-foot-lock-r* w) 0.0)
(define *enhanced-sig-foot-down-l* #f)
(define *enhanced-sig-foot-down-r* #f)

;; on Jak's run: how much his feet come in toward his midline (0-1, by enhanced-skin-run-weight)
(define *enhanced-sig-run-narrow* 0.3)
;; and how much less he lifts his feet than Jak (0-1). With *enhanced-skin-run-lift*: ankle spread against
;; hip width 0.85 -> 0.71 at a run
(define *enhanced-sig-run-step* 0.45)

(defbehavior enhanced-sig-legs enhanced-skin ()
  "Sized, in Jak's pose: his ankles where Jak's are against his root, forward and back as far as Jak's (so
   his feet stay planted at Jak's speed: his legs are longer), sideways and up scaled by his size. His feet
   keep their turn. A foot Jak has on the ground stays where it was put down (Jak's body goes up to 0.9 m
   ahead of his root and back in his run: taken against it, the planted foot slid ~2 m/s); it lets go when
   Jak lifts it or when it would be 0.4 m from his leg's place."
  (let ((tgt (-> self parent 0))
        (w (-> self pose-blend))
        )
    (when (not (and (< 0.0 w)
                    (-> self char sized)
                    (not (focus-test? tgt pilot pilot-riding edge-grab pole flut board mech tube))
                    )
               )
      (set! (-> *enhanced-sig-foot-lock-l* w) 0.0)
      (set! (-> *enhanced-sig-foot-lock-r* w) 0.0)
      )
    (when (and (< 0.0 w)
               (-> self char sized)
               (not (focus-test? tgt pilot pilot-riding edge-grab pole flut board mech tube))
               )
      (let* ((jn (-> tgt node-list))
             (nodes (-> self node-list))
             (jroot (-> jn data 2 bone transform trans))
             (sroot (-> nodes data 0 bone transform trans))
             (fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self root quat)))
             (o (new 'stack-no-clear 'vector))
             (t (new 'stack-no-clear 'vector))
             (inv (new 'stack-no-clear 'matrix))
             (size (-> self size))
             )
        (set! (-> fwd y) 0.0)
        (set! (-> fwd w) 0.0)
        (vector-normalize! fwd 1.0)
        (dotimes (leg 2)
          (let* ((jank (if (zero? leg) 41 47))
                 (thigh (if (zero? leg) 18 22))
                 (a (-> nodes data (+ thigh 2) bone transform trans))
                 ;; their ankles' heights in their bind poses: only the lift above it is scaled
                 (jh (begin
                       (matrix-4x4-inverse! inv (-> jn data jank joint bind-pose))
                       (-> inv trans y)
                       )
                     )
                 (sh (-> self bind-world (+ thigh 2) trans y))
                 )
            (vector-! o (-> jn data jank bone transform trans) jroot)
            (set! (-> o w) 0.0)
            (let ((f (vector-dot o fwd)))
              (vector-float*! t o size)
              (vector+float*! t t fwd (* f (- 1.0 size)))
              ;; running: his feet closer to his midline (Jak's run spread at his size looked wide-legged)
              (let ((k (* *enhanced-sig-run-narrow* (enhanced-skin-run-weight tgt)))
                    (along (vector-dot t fwd))
                    )
                (when (< 0.0 k)
                  (set! (-> t x) (- (-> t x) (* k (- (-> t x) (* along (-> fwd x))))))
                  (set! (-> t z) (- (-> t z) (* k (- (-> t z) (* along (-> fwd z))))))
                  )
                )
              )
            ;; (running: his feet lifted less than Jak's high-kneed run has them, at his size a gallop)
            (set! (-> t y) (+ sh (* size (- (-> o y) jh) (- 1.0 (* *enhanced-sig-run-step* (enhanced-skin-run-weight tgt))))))
            (vector+! t t sroot)
            ;; planted: Jak's ankle within 5 cm of its standing height, on the ground, not attacking (his
            ;; attacks slide on purpose)
            (let* ((lock (if (zero? leg) *enhanced-sig-foot-lock-l* *enhanced-sig-foot-lock-r*))
                   (was (if (zero? leg) *enhanced-sig-foot-down-l* *enhanced-sig-foot-down-r*))
                   (down (and (< (- (-> jn data jank bone transform trans y) (-> tgt control trans y)) (+ jh (meters 0.05)))
                              (logtest? (-> tgt control status) (collide-status on-surface))
                              (not (enhanced-sig-attacking? tgt))
                              )
                         )
                   (lw (-> lock w))
                   )
              ;; (lock y: 1 while it holds, 0 once let go until Jak lifts that foot)
              (cond
                ((and down (not was))
                 ;; just put down: from where it is now (blended, if it was still letting go)
                 (set! (-> lock x) (lerp (-> t x) (-> lock x) lw))
                 (set! (-> lock z) (lerp (-> t z) (-> lock z) lw))
                 (set! (-> lock y) 1.0)
                 (set! lw 1.0)
                 )
                ((and down (< (meters 0.4) (sqrtf (+ (* (- (-> t x) (-> lock x)) (- (-> t x) (-> lock x)))
                                                      (* (- (-> t z) (-> lock z)) (- (-> t z) (-> lock z)))
                                                      )
                                                   )
                              )
                      )
                 ;; too far from where his leg would put it: let it go
                 (set! (-> lock y) 0.0)
                 )
                )
              (if (not (and down (< 0.5 (-> lock y))))
                  (set! lw (fmax 0.0 (- lw (* 10.0 (seconds-per-frame)))))
                  )
              (set! (-> lock w) lw)
              (if (zero? leg)
                  (set! *enhanced-sig-foot-down-l* down)
                  (set! *enhanced-sig-foot-down-r* down)
                  )
              (set! (-> t x) (lerp (-> t x) (-> lock x) lw))
              (set! (-> t z) (lerp (-> t z) (-> lock z) lw))
              )
            (set! (-> t w) 1.0)
            (vector-lerp! t a t w)
            (set! (-> t w) 1.0)
            (enhanced-sig-limb-ik! thigh (+ thigh 1) (+ thigh 2)
                                   (vector-copy! (new 'stack-no-clear 'vector) (-> nodes data thigh bone transform trans))
                                   t
                                   #t
                                   )
            )
          )
        )
      )
    )
  (none)
  )

;; His two-handed hold: the Peacemaker as he holds it to fire in the arena fight's end (arena-fight-3-res,
;; chunk 2, frame 40: the barrel across his body to his left, left hand under it, right hand on the grip).
;; Local turns (joint to its parent) of his arms, the gun (to his right hand) and his fingers: slots 0-5
;; joints 11-16, slot 6 the gun (26), slots 7-36 joints 29-58.
(define *enhanced-sig-two-hand*
  (new 'static 'inline-array quaternion 37
    (new 'static 'quaternion :x 0.562770 :y -0.099516 :z -0.148619 :w 0.807030)
    (new 'static 'quaternion :x 0.988707 :y -0.029113 :z -0.090301 :w -0.115997)
    (new 'static 'quaternion :x 0.195319 :y -0.761868 :z -0.234322 :w 0.571401)
    (new 'static 'quaternion :x 0.216401 :y -0.359926 :z 0.748172 :w 0.513674)
    (new 'static 'quaternion :x 0.933202 :y 0.031555 :z 0.060486 :w -0.352815)
    (new 'static 'quaternion :x 0.907140 :y 0.192604 :z -0.342756 :w 0.150060)
    (new 'static 'quaternion :x 0.577473 :y 0.070520 :z 0.060382 :w 0.811113)
    (new 'static 'quaternion :x -0.495369 :y 0.785261 :z 0.156130 :w 0.337041)
    (new 'static 'quaternion :x -0.123811 :y -0.112306 :z 0.402959 :w 0.899823)
    (new 'static 'quaternion :x 0.115325 :y 0.812042 :z -0.055450 :w 0.569396)
    (new 'static 'quaternion :x -0.396822 :y 0.672459 :z 0.280549 :w 0.558231)
    (new 'static 'quaternion :x 0.002624 :y 0.942029 :z -0.315342 :w 0.114595)
    (new 'static 'quaternion :x 0.049896 :y 0.948828 :z 0.311708 :w -0.008514)
    (new 'static 'quaternion :x -0.375856 :y 0.600925 :z 0.365419 :w 0.603397)
    (new 'static 'quaternion :x 0.019256 :y 0.906970 :z -0.420693 :w 0.007049)
    (new 'static 'quaternion :x 0.013794 :y 0.907355 :z 0.420108 :w -0.005035)
    (new 'static 'quaternion :x -0.436193 :y 0.556526 :z 0.436224 :w 0.556526)
    (new 'static 'quaternion :x -0.420413 :y 0.003112 :z 0.001434 :w 0.907326)
    (new 'static 'quaternion :x -0.420416 :y 0.000000 :z 0.000000 :w 0.907331)
    (new 'static 'quaternion :x 0.439370 :y -0.593975 :z 0.430245 :w 0.518686)
    (new 'static 'quaternion :x 0.421541 :y 0.047607 :z 0.025909 :w 0.905187)
    (new 'static 'quaternion :x 0.420465 :y -0.000854 :z 0.002441 :w 0.907305)
    (new 'static 'quaternion :x -0.314834 :y -0.086460 :z 0.806312 :w -0.493217)
    (new 'static 'quaternion :x -0.084381 :y 0.118622 :z -0.274904 :w 0.950387)
    (new 'static 'quaternion :x 0.112185 :y -0.812399 :z 0.053987 :w 0.569655)
    (new 'static 'quaternion :x -0.633074 :y -0.113406 :z 0.734639 :w -0.216009)
    (new 'static 'quaternion :x -0.002441 :y 0.893178 :z -0.436472 :w -0.108248)
    (new 'static 'quaternion :x -0.022582 :y 0.894650 :z 0.436155 :w 0.094115)
    (new 'static 'quaternion :x -0.530862 :y -0.460518 :z 0.541544 :w -0.461342)
    (new 'static 'quaternion :x 0.005066 :y 0.796290 :z -0.602803 :w 0.050233)
    (new 'static 'quaternion :x -0.002288 :y 0.807923 :z 0.589103 :w -0.014526)
    (new 'static 'quaternion :x 0.415172 :y 0.572402 :z -0.415141 :w 0.572402)
    (new 'static 'quaternion :x -0.521948 :y 0.000000 :z 0.000000 :w 0.852976)
    (new 'static 'quaternion :x -0.521948 :y 0.000000 :z 0.000000 :w 0.852976)
    (new 'static 'quaternion :x -0.291236 :y -0.599563 :z -0.303596 :w 0.680833)
    (new 'static 'quaternion :x 0.493706 :y 0.006439 :z -0.053801 :w 0.867938)
    (new 'static 'quaternion :x 0.496061 :y -0.002471 :z -0.000640 :w 0.868283)
    )
  )

;; the gun's grip in his right hand (the gun joint to the hand, same pose)
(define *enhanced-sig-grip* (new 'static 'vector :x 516.0 :y -2185.625 :z 1974.875 :w 1.0))
;; how much his chest turns to his right to hold it forward (the rest: his arms bring it round)
(define *enhanced-sig-twist* (degrees 45))

(defun enhanced-sig-two-hand-slot ((k int))
  "Joint k's slot in *enhanced-sig-two-hand*, else -1."
  (cond
    ((and (>= k 11) (< k 17)) (+ k -11))
    ((= k SIG_GUN) 6)
    ((and (>= k 29) (< k 59)) (+ k -22))
    (else -1)
    )
  )

(defbehavior enhanced-sig-grip! enhanced-skin ((dst matrix))
  "dst = the gun as his right hand grips it in his two-handed hold."
  (let ((loc (new 'stack-no-clear 'matrix)))
    (quaternion->matrix loc (-> *enhanced-sig-two-hand* 6))
    (vector-copy! (-> loc trans) *enhanced-sig-grip*)
    (matrix*! dst loc (-> self node-list data SIG_RHAND bone transform))
    )
  dst
  )

(defbehavior enhanced-sig-two-hand! enhanced-skin ((w float) (dir vector))
  "By w: his two-handed hold over what his bones have now, the barrel along dir. His chest turns right by
   *enhanced-sig-twist* (his head back toward dir), his arms take the hold's pose from it, then the hold
   turns round his shoulders until the barrel points along dir; his arms (IK) reach it from where his
   shoulders are."
  (let* ((st *enhanced-sig-gun*)
         (nodes (-> self node-list))
         (n (min 80 (-> nodes length)))
         (q (new 'stack-no-clear 'quaternion))
         (loc (new 'stack-no-clear 'matrix))
         (inv (new 'stack-no-clear 'matrix))
         (lsh (new 'stack-no-clear 'vector))
         (rsh (new 'stack-no-clear 'vector))
         (pivot (new 'stack-no-clear 'vector))
         (barrel (new 'stack-no-clear 'vector))
         )
    (dotimes (k n)
      (matrix-copy! (-> st before k) (-> nodes data k bone transform))
      )
    ;; his chest to his right, his head back
    (quaternion-axis-angle! q 0.0 1.0 0.0 (- *enhanced-sig-twist*))
    (enhanced-sig-turn-tree! 4 q (-> nodes data 4 bone transform trans))
    (quaternion-axis-angle! q 0.0 1.0 0.0 (* 0.85 *enhanced-sig-twist*))
    (enhanced-sig-turn-tree! 5 q (-> nodes data 5 bone transform trans))
    ;; his arms, fingers and the gun as in the hold, from his chest down
    (dotimes (k n)
      (let ((slot (enhanced-sig-two-hand-slot k))
            (p (enhanced-sig-gun-parent nodes k))
            )
        (when (and (>= slot 0) (>= p 0) (< p k))
          (quaternion->matrix loc (-> *enhanced-sig-two-hand* slot))
          (cond
            ((= k SIG_GUN)
             (vector-copy! (-> loc trans) *enhanced-sig-grip*)
             )
            (else
              ;; its bone's length as it is
              (matrix-4x4-inverse! inv (-> st before p))
              (vector-matrix*! (-> loc trans) (-> st before k trans) inv)
              )
            )
          (set! (-> loc trans w) 1.0)
          (matrix*! (-> nodes data k bone transform) loc (-> nodes data p bone transform))
          )
        )
      )
    (matrix*! (-> nodes data SIG_BLAST bone transform) (-> st blast-local) (-> nodes data SIG_GUN bone transform))
    ;; the hold turned about his shoulders so the barrel points along dir
    (vector-copy! lsh (-> nodes data SIG_LSHOULDER bone transform trans))
    (vector-copy! rsh (-> nodes data SIG_RSHOULDER bone transform trans))
    (vector-lerp! pivot lsh rsh 0.5)
    (vector-normalize-copy! barrel (-> nodes data SIG_GUN bone transform fvec) 1.0)
    (quaternion-from-two-vectors! q barrel dir)
    (enhanced-sig-turn-tree! SIG_LSHOULDER q pivot)
    (enhanced-sig-turn-tree! SIG_RSHOULDER q pivot)
    ;; his arms reach it from his shoulders (the hands keep their grip)
    (enhanced-sig-limb-ik! SIG_RSHOULDER SIG_RELBOW SIG_RHAND rsh
                           (vector-copy! (new 'stack-no-clear 'vector) (-> nodes data SIG_RHAND bone transform trans)) #t)
    (enhanced-sig-limb-ik! SIG_LSHOULDER SIG_LELBOW 13 lsh
                           (vector-copy! (new 'stack-no-clear 'vector) (-> nodes data 13 bone transform trans)) #t)
    ;; all of it by w
    (when (< w 1.0)
      (dotimes (k n)
        (enhanced-matrix-blend-rows! (-> nodes data k bone transform) (-> st before k) (-> nodes data k bone transform) w (-> st before k))
        )
      )
    )
  (none)
  )

;; Two joints' local turns mixed by slerp, not by blending matrix rows: rows lerped between turns far
;; apart (his walk's swung arm and the plain idle's hanging one) come out nearly parallel once
;; renormalized (measured: arm bones' rows up to 0.93 cos apart walking unarmed, sheared arms).
(defun enhanced-sig-slerp-local! ((dst matrix) (a matrix) (b matrix) (w float))
  "dst = a's turn toward b's by w (slerp), a's row lengths, a's trans. dst may be a."
  (let ((na (new 'stack-no-clear 'matrix))
        (nb (new 'stack-no-clear 'matrix))
        (qa (new 'stack-no-clear 'quaternion))
        (qb (new 'stack-no-clear 'quaternion))
        (len (new 'stack-no-clear 'vector))
        (tr (vector-copy! (new 'stack-no-clear 'vector) (-> a trans)))
        )
    (matrix-copy! na a)
    (matrix-copy! nb b)
    (dotimes (r 3)
      (set! (-> len data r) (vector-length (-> a vector r)))
      (set! (-> na vector r w) 0.0)
      (set! (-> nb vector r w) 0.0)
      (vector-normalize! (-> na vector r) 1.0)
      (vector-normalize! (-> nb vector r) 1.0)
      )
    (matrix->quaternion qa na)
    (matrix->quaternion qb nb)
    (quaternion-slerp! qa qa qb w)
    (quaternion-normalize! qa)
    (quaternion->matrix dst qa)
    (dotimes (r 3)
      (vector-float*! (-> dst vector r) (-> dst vector r) (-> len data r))
      (set! (-> dst vector r w) 0.0)
      )
    (vector-copy! (-> dst trans) tr)
    (set! (-> dst trans w) 1.0)
    dst
    )
  )

;; walking unarmed: how far both arms go toward his plain idle's hanging ones (0-1). His museum walk
;; swings each arm up to shoulder height, Jak's walk and run (his pose, taken above his own walk's speeds)
;; swing them far out at his size: both look exaggerated on him.
(define *enhanced-sig-calm-weight* 0.0)
(define *enhanced-sig-calm-own* 0.55)   ;; on his own walk
(define *enhanced-sig-calm-jak* 0.4)    ;; on Jak's walk and run

(defun enhanced-sig-plain-arm-weight ((k int) (rest-w float))
  "Joint k's weight toward his plain idle's arm: standing unarmed (rest-w) his right arm, walking
   (*enhanced-sig-calm-weight*) both arms; 0 for his other joints."
  (let ((ra *enhanced-sig-plain-arms*))
    (cond
      ((not (and (-> ra ok) (< k 80))) 0.0)
      ((= (-> ra arm k) 1) rest-w)
      (else 0.0)
      )
    )
  )

(defbehavior enhanced-sig-hold-pose enhanced-skin ((out-w float) (rest-w float))
  "His arms and gun over what his bones have now (what hangs from them following): by rest-w (standing
   unarmed) his arms in closer to his body, the left forearm forward; by out-w the wasdoors idle's right
   arm and the gun from his back to his hand."
  (let* ((st *enhanced-sig-gun*)
         (ra *enhanced-sig-plain-arms*)
         (nodes (-> self node-list))
         (n (min 80 (-> nodes length)))
         (local (new 'stack-no-clear 'matrix))
         (inv (new 'stack-no-clear 'matrix))
         (mixed (new 'stack-no-clear 'matrix))
         ;; the rest pose's turns, per rest slot
         (q-rest (new 'stack-no-clear 'inline-array 'quaternion 4))
         )
    (dotimes (k n)
      (matrix-copy! (-> st before k) (-> nodes data k bone transform))
      (set! (-> st moved k) 0)
      )
    ;; the rest pose's turns: his idle's arms hang straight down from his wide shoulders, the left forearm
    ;; back. Upper arms in toward his sides, the left forearm forward (his hands at his thighs).
    (when (< 0.0 rest-w)
      (let ((right (vector-! (new 'stack-no-clear 'vector) (-> st before SIG_RSHOULDER trans) (-> st before SIG_LSHOULDER trans)))
            (fwd (new 'stack-no-clear 'vector))
            (down (new 'stack-no-clear 'vector))
            (to (new 'stack-no-clear 'vector))
            )
        (set! (-> right w) 0.0)
        (vector-flatten! right right *up-vector*)
        (vector-normalize! right 1.0)
        (vector-z-quaternion! fwd (-> self root quat))
        (set! (-> fwd w) 0.0)
        (vector-flatten! fwd fwd *up-vector*)
        (vector-normalize! fwd 1.0)
        (set-vector! down 0.0 -1.0 0.0 0.0)
        (dotimes (slot 4)
          (let ((side (case slot
                        ((0) (degrees -5))   ;; right upper arm: in (toward his left)
                        ((2) (degrees 5))    ;; left upper arm: in
                        (else (degrees 0))
                        )
                      )
                (ahead (case slot
                         ((1) (degrees 4))   ;; right forearm: already forward, a little more
                         ((3) (degrees 4))   ;; left forearm: the wasdoors idle has it along his side
                         (else (degrees 0))
                         )
                       )
                )
            (vector-copy! to down)
            (vector+float*! to to right (tan side))
            (vector+float*! to to fwd (tan ahead))
            (vector-normalize! to 1.0)
            (quaternion-from-two-vectors-partial! (-> q-rest slot) down to rest-w)
            )
          )
        )
      )
    (dotimes (k n)
      (let ((p (enhanced-sig-gun-parent nodes k))
            (slot (enhanced-sig-hold-slot k))
            (rest (enhanced-sig-rest-slot k))
            )
        (when (and (> k 0) (>= p 0) (< p k))
          (cond
            ((= k SIG_GUN)
             ;; from where enhanced-skin-big-gun put it (his back) to his hand, as the wasdoors idle holds it
             (when (< 0.0 out-w)
               (matrix*! mixed (-> st hold-local 3) (-> nodes data SIG_RHAND bone transform))
               (enhanced-matrix-blend-rows! (-> nodes data k bone transform) (-> st before k) mixed out-w (-> st before k))
               (set! (-> st moved k) 1)
               )
             )
            ((= k SIG_BLAST)
             (when (nonzero? (-> st moved SIG_GUN))
               (matrix*! (-> nodes data k bone transform) (-> st blast-local) (-> nodes data SIG_GUN bone transform))
               (set! (-> st moved k) 1)
               )
             )
            ((or (and (>= slot 0) (< 0.0 out-w)) (and (>= rest 0) (< 0.0 rest-w)) (nonzero? (-> st moved p))
                 (< 0.0 (enhanced-sig-plain-arm-weight k rest-w))
                 )
             (let ((bone (-> nodes data k bone transform))
                   (pw (enhanced-sig-plain-arm-weight k rest-w))
                   )
               ;; its own, where its parent is now
               (matrix-4x4-inverse! inv (-> st before p))
               (matrix*! local (-> st before k) inv)
               ;; toward his plain idle's hanging arm: standing unarmed, his right one (the wasdoors idle
               ;; holds the gun up); walking, both, part way (his walk swings them up to his shoulders)
               (when (< 0.0 pw)
                 (let ((m (if (< k 80) (-> ra mirror k) -1)))
                   ;; standing: the right arm as the wasdoors idle's left one, mirrored
                   (when (and (< 0.0 rest-w) (>= m 0))
                     (let ((mp (enhanced-sig-gun-parent nodes m)))
                       (matrix-4x4-inverse! inv (-> st before mp))
                       (matrix*! mixed (-> st before m) inv)
                       (enhanced-sig-mirror! inv mixed)
                       (enhanced-sig-slerp-local! local local inv rest-w)
                       )
                     )
                   )
                 )
               (matrix*! bone local (-> nodes data p bone transform))
               ;; unarmed, standing: the rest turn (about the joint)
               (when (and (>= rest 0) (< 0.0 rest-w))
                 (dotimes (r 3)
                   (let ((w0 (-> bone vector r w)))
                     (vector-orient-by-quat! (-> bone vector r) (-> bone vector r) (-> q-rest rest))
                     (set! (-> bone vector r w) w0)
                     )
                   )
                 )
               ;; armed: the wasdoors idle's right arm
               (when (and (>= slot 0) (< 0.0 out-w))
                 (matrix*! mixed (-> st hold-local slot) (-> nodes data p bone transform))
                 (enhanced-matrix-blend-rows! bone (matrix-copy! local bone) mixed out-w local)
                 )
               )
             (set! (-> st moved k) 1)
             )
            )
          )
        )
      )
    )
  (none)
  )

(defun enhanced-sig-gun-test-step ((tgt target))
  "JAK_ENHANCED_SIG_GUN_TEST: a step toward the camera (his front), one sideways (his side), a walk away;
   D-pad right (out), a step sideways, fire standing, walk firing; D-pad right (away)."
  (let* ((st *enhanced-sig-gun*)
         (t (-> st test-frame))
         )
    (+! (-> st test-frame) 1)
    (case t
      ((1) (set-ignore-controller-in-bg! *pc-settings* #t))
      ((400) (format 0 "[sig-gun] shot idle-front~%"))
      ((640) (format 0 "[sig-gun] shot idle-side~%"))
      ((900) (format 0 "[sig-gun] shot walk~%"))
      ((1080) (set! *enhanced-pad-press* (pad-buttons right)) (format 0 "[sig-gun] test: d-pad right (out)~%"))
      ((1260) (format 0 "[sig-gun] shot armed~%"))
      ((1300) (format 0 "[sig-gun] test: fire standing~%"))
      ((1370) (format 0 "[sig-gun] shot fire~%"))
      ((1600) (format 0 "[sig-gun] test: walk firing~%"))
      ((1900)
       ;; (only if it's out: D-pad right toggles it)
       (cond
         ((using-gun? tgt)
          (set! *enhanced-pad-press* (pad-buttons right))
          (format 0 "[sig-gun] test: d-pad right (away)~%")
          )
         (else
           (format 0 "[sig-gun] test: already away~%")
           )
         )
       )
      ((2100) (format 0 "[sig-gun] test: done~%"))
      )
    (set! *enhanced-pad-hold* (if (or (and (>= t 1300) (< t 1390)) (and (>= t 1450) (< t 1540))
                                      (and (>= t 1620) (< t 1700)) (and (>= t 1740) (< t 1820))
                                      )
                                  (pad-buttons r1)
                                  (pad-buttons)
                                  )
          )
    ;; a step toward the camera (he turns to face it), one to his side, a walk away from it
    (set! *enhanced-pad-lefty* (cond
                                 ((and (>= t 200) (< t 215)) 255)
                                 ((or (and (>= t 700) (< t 1000)) (and (>= t 1600) (< t 1850))) 90)
                                 (else -1)
                                 )
          )
    ;; (and with the gun out, one to his side: the hold and the shots seen from the side)
    (set! *enhanced-pad-leftx* (if (or (and (>= t 480) (< t 492)) (and (>= t 1150) (< t 1162))) 255 -1))
    )
  (none)
  )

;; his two-handed hold's weight (0-1); how much an attack's arms take over is *enhanced-sig-attack-weight*
;; (enhanced-player.gc, where the retarget reads it)
(define *enhanced-sig-two-weight* 0.0)

(defun enhanced-sig-attacking? ((tgt target))
  "Jak punching, kicking or diving fists first (and a moment after)."
  (let ((st (-> tgt state)))
    (or (and st
             (or (= (-> st name) 'target-attack)
                 (= (-> st name) 'target-running-attack)
                 (= (-> st name) 'target-attack-air)
                 (= (-> st name) 'target-attack-uppercut)
                 (= (-> st name) 'target-attack-uppercut-jump)
                 (= (-> st name) 'target-darkjak-running-attack)
                 ;; the dive (jump, square) and its landing punch: his arms hung at his sides through it
                 (= (-> st name) 'target-flop)
                 (= (-> st name) 'target-flop-hit-ground)
                 )
             )
        (< (- (-> tgt clock frame-counter) (-> tgt control last-attack-end-time)) (seconds 0.15))
        )
    )
  )

;; His skirt panels, belt bags and water bottle hang from his thighs (skirtLA/RA on Lthigh/Rthigh) and
;; the skirt flaps from his hips. In Jak's pose (his run, with the legs' IK) the panels' lower joints kept
;; his own walk's cloth swing (played up to rate 2, out of step with Jak's legs) on top of the leg swing.
;; By pose-blend x this, those lower joints go toward their bind turns (the panel straight along the
;; thigh); each chain's top still follows its thigh, so the legs stay inside the panels.
(define *enhanced-sig-skirt-damp* 0.8)
(defconstant SIG_HIPS 17)
(defconstant SIG_SKIRT_FIRST 63)  ;; skirtLA; from it on: skirts, bags, bottle, flaps (to 75)

;; A skirt panel's top follows its thigh, but not all the way: with the leg kicked up behind him on the
;; run the rear panel flipped up and out almost level. Its line (top to next joint) may leave its hanging
;; line (bind, carried by his hips) by at most these: behind him (the leg going back) and in front (the
;; knee coming through: more, so the leg stays inside).
(define *enhanced-sig-skirt-back-max* (degrees 28))
(define *enhanced-sig-skirt-front-max* (degrees 45))

(defbehavior enhanced-sig-skirt-clamp enhanced-skin ()
  "skirtLA (63) and skirtRA (68) turned back toward hanging when they swing past the limits."
  (let* ((nodes (-> self node-list))
         (m (new 'stack-no-clear 'matrix))
         (cur (new 'stack-no-clear 'vector))
         (rest (new 'stack-no-clear 'vector))
         (fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self root quat)))
         (q (new 'stack-no-clear 'quaternion))
         )
    (set! (-> fwd w) 0.0)
    (vector-normalize! fwd 1.0)
    ;; his hips' turn from the bind pose
    (matrix-4x4-inverse! m (-> self bind-world SIG_HIPS))
    (matrix*! m m (-> nodes data SIG_HIPS bone transform))
    (dotimes (i 2)
      (let ((k (if (zero? i) 63 68)))
        (vector-! cur (-> nodes data (+ k 1) bone transform trans) (-> nodes data k bone transform trans))
        (set! (-> cur w) 0.0)
        (vector-normalize! cur 1.0)
        (vector-! rest (-> self bind-world (+ k 1) trans) (-> self bind-world k trans))
        (set! (-> rest w) 0.0)
        (vector-matrix*! rest rest m)
        (set! (-> rest w) 0.0)
        (vector-normalize! rest 1.0)
        (let* ((ang (acos (fmax -1.0 (fmin 1.0 (vector-dot cur rest)))))
               (lim (if (< (vector-dot cur fwd) (vector-dot rest fwd)) *enhanced-sig-skirt-back-max* *enhanced-sig-skirt-front-max*))
               )
          (when (< lim ang)
            (quaternion-from-two-vectors-partial! q cur rest (- 1.0 (/ lim ang)))
            (enhanced-sig-turn-tree! k q (vector-copy! (new 'stack-no-clear 'vector) (-> nodes data k bone transform trans)))
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior enhanced-sig-skirt enhanced-skin ()
  "His skirt and what hangs with it, toward hanging from his hips (see *enhanced-sig-skirt-damp*)."
  (let* ((st *enhanced-sig-gun*)
         (nodes (-> self node-list))
         (n (min 80 (-> nodes length)))
         (w (* (-> self pose-blend) *enhanced-sig-skirt-damp*))
         (inv (new 'stack-no-clear 'matrix))
         (local (new 'stack-no-clear 'matrix))
         (bl (new 'stack-no-clear 'matrix))
         )
    (when (and (< 0.0 w) (> n SIG_SKIRT_FIRST))
      (enhanced-sig-skirt-clamp)
      (dotimes (k n)
        (set! (-> st moved k) 0)
        (if (>= k SIG_SKIRT_FIRST)
            (matrix-copy! (-> st before k) (-> nodes data k bone transform))
            )
        )
      (let ((k SIG_SKIRT_FIRST))
        (while (< k n)
          (let ((p (enhanced-sig-gun-parent nodes k)))
            (when (and (> p 0) (< p k))
              (cond
                ((or (= p SIG_HIPS) (= p 18) (= p 22))
                 ;; a chain's top follows its thigh (or hips) as it is: held back toward the hips, the
                 ;; swinging knees came through the panels
                 (set! (-> st moved k) 1)
                 )
                ((nonzero? (-> st moved p))
                 (matrix-4x4-inverse! inv (-> st before p))
                 (matrix*! local (-> st before k) inv)
                 (matrix-inverse-of-rot-trans! inv (-> self bind-world p))
                 (matrix*! bl (-> self bind-world k) inv)
                 (enhanced-sig-slerp-local! local local bl w)
                 (matrix*! (-> nodes data k bone transform) local (-> nodes data p bone transform))
                 (set! (-> st moved k) 1)
                 )
                )
              )
            )
          (+! k 1)
          )
        )
      )
    )
  (none)
  )

;; Walking or running unarmed, his arms are driven here: neither his museum walk (right arm held bent
;; forward, each arm swung up to his shoulders) nor Jak's arms (through his bind pose they cross both hands
;; in front of his chest) look right on him. Each upper arm hangs at his side and swings forward and back
;; opposite to his legs (left arm with the right thigh, phase-locked to it), the elbow bent a little more
;; when running; set by direction (shortest turns of the upper arm and forearm subtrees), by w.
(define *enhanced-sig-arm-swing-walk* (degrees 16))
(define *enhanced-sig-arm-swing-run* (degrees 32))
(define *enhanced-sig-elbow-walk* (degrees 15))
(define *enhanced-sig-elbow-run* (degrees 50))

(defbehavior enhanced-sig-calm-arms enhanced-skin ((w float))
  "Both arms by w: hanging at his sides, swinging against his legs (his gun on his back stays where it is)."
  (let* ((nodes (-> self node-list))
         (tgt (-> self parent 0))
         (run (enhanced-skin-run-weight tgt))
         (amp (lerp *enhanced-sig-arm-swing-walk* *enhanced-sig-arm-swing-run* run))
         (bend (lerp *enhanced-sig-elbow-walk* *enhanced-sig-elbow-run* run))
         (right (vector-! (new 'stack-no-clear 'vector) (-> nodes data SIG_RSHOULDER bone transform trans)
                          (-> nodes data SIG_LSHOULDER bone transform trans)))
         (fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self root quat)))
         (gun (matrix-copy! (new 'stack-no-clear 'matrix) (-> nodes data SIG_GUN bone transform)))
         (blast (matrix-copy! (new 'stack-no-clear 'matrix) (-> nodes data SIG_BLAST bone transform)))
         (from (new 'stack-no-clear 'vector))
         (to (new 'stack-no-clear 'vector))
         (leg (new 'stack-no-clear 'vector))
         (perp (new 'stack-no-clear 'vector))
         (q (new 'stack-no-clear 'quaternion))
         )
    (set! (-> right w) 0.0)
    (vector-flatten! right right *up-vector*)
    (vector-normalize! right 1.0)
    (set! (-> fwd w) 0.0)
    (vector-flatten! fwd fwd *up-vector*)
    (vector-normalize! fwd 1.0)
    (dotimes (side 2)
      (let* ((sh (if (zero? side) SIG_LSHOULDER SIG_RSHOULDER))
             (el (+ sh 1))
             (hand (+ sh 2))
             ;; the other side's leg against his own: how far its ankle is ahead of this side's (-1 back ..
             ;; 1 forward; against each other, so his lean and bent knees don't push both arms forward)
             (thigh (if (zero? side) 22 18))
             (s (let ((d 0.0))
                  (dotimes (i 2)
                    (let ((th (if (zero? i) thigh (if (= thigh 22) 18 22))))
                      (vector-! leg (-> nodes data (+ th 2) bone transform trans) (-> nodes data th bone transform trans))
                      (set! (-> leg w) 0.0)
                      (vector-normalize! leg 1.0)
                      (+! d (* (if (zero? i) 1.0 -1.0) (vector-dot leg fwd)))
                      )
                    )
                  (fmax -1.0 (fmin 1.0 (/ d 0.7)))
                  )
                )
             (a (* s amp))
             )
        ;; the upper arm: down, swung forward or back by a, a little out to his side
        (set-vector! to 0.0 (- (cos a)) 0.0 0.0)
        (vector+float*! to to fwd (sin a))
        (vector+float*! to to right (if (zero? side) -0.06 0.06))
        (vector-normalize! to 1.0)
        (vector-! from (-> nodes data el bone transform trans) (-> nodes data sh bone transform trans))
        (set! (-> from w) 0.0)
        (vector-normalize! from 1.0)
        (quaternion-from-two-vectors-partial! q from to w)
        (enhanced-sig-turn-tree! sh q (vector-copy! (new 'stack-no-clear 'vector) (-> nodes data sh bone transform trans)))
        ;; the forearm: the upper arm's line bent forward by bend (a bit more as the arm swings forward)
        (vector-! from (-> nodes data el bone transform trans) (-> nodes data sh bone transform trans))
        (set! (-> from w) 0.0)
        (vector-normalize! from 1.0)
        (vector-copy! perp fwd)
        (vector+float*! perp perp from (- (vector-dot fwd from)))
        (set! (-> perp w) 0.0)
        (vector-normalize! perp 1.0)
        (let ((b (+ bend (* 0.25 (fmax 0.0 a)))))
          (vector-float*! to from (cos b))
          (vector+float*! to to perp (sin b))
          )
        (set! (-> to w) 0.0)
        (vector-normalize! to 1.0)
        (vector-! from (-> nodes data hand bone transform trans) (-> nodes data el bone transform trans))
        (set! (-> from w) 0.0)
        (vector-normalize! from 1.0)
        (quaternion-from-two-vectors-partial! q from to w)
        (enhanced-sig-turn-tree! el q (vector-copy! (new 'stack-no-clear 'vector) (-> nodes data el bone transform trans)))
        )
      )
    (matrix-copy! (-> nodes data SIG_GUN bone transform) gun)
    (matrix-copy! (-> nodes data SIG_BLAST bone transform) blast)
    )
  (none)
  )

(defbehavior enhanced-sig-gun-post enhanced-skin ()
  "Each frame after his bones are done (enhanced-skin-post, after enhanced-skin-big-gun put the gun on his
   back): his arms, the gun out in his hand, its muzzle for Jak's shots (enhanced-player-muzzle!)."
  (let ((st *enhanced-sig-gun*)
        (tgt (-> self parent 0))
        )
    (when (= (-> self pid) (-> st pid))
      (if *enhanced-sig-gun-test*
          (enhanced-sig-gun-test-step tgt)
          )
      ;; his feet (in Jak's pose: planted at his size), then his skirt off Jak's leg swing
      (enhanced-sig-legs)
      (enhanced-sig-skirt)
      (let* ((out? (and (nonzero? (-> tgt gun)) (using-gun? tgt) (not (focus-test? tgt pilot))))
             ;; charging (R1 held) or just fired
             (aim? (and out?
                        (or (cpad-hold? (-> tgt control cpad number) r1)
                            (not (time-elapsed? (-> tgt gun fire-time) (seconds 0.8)))
                            )
                        )
                   )
             ;; punching or kicking: Jak's arms (his gun stays in his right hand)
             (attack? (enhanced-sig-attacking? tgt))
             ;; both hands on it moving or firing; standing, his NPC's wasdoors hold
             (two? (and out? (not attack?) (or aim? (not (enhanced-sig-gun-stand?)))))
             (fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self root quat)))
             (dir (new 'stack-no-clear 'vector))
             )
        ;; out of and onto his back in 0.3 s (as Jak takes his out)
        (seek! (-> st out-blend) (if out? 1.0 0.0) (* 3.3 (seconds-per-frame)))
        (seek! (-> st aim-weight) (if aim? 1.0 0.0) (* 5.0 (seconds-per-frame)))
        (seek! *enhanced-sig-two-weight* (if two? 1.0 0.0) (* 5.0 (seconds-per-frame)))
        (seek! (-> st rest-weight)
               (if (and (not out?) (= (-> self anim) (-> self char idle))) (- 1.0 (-> self pose-blend)) 0.0)
               (* 5.0 (seconds-per-frame))
               )
        ;; walking or running unarmed: his arms swing at his sides (enhanced-sig-calm-arms)
        (seek! *enhanced-sig-calm-weight*
               (if (and (not out?) (not attack?)
                        (< (meters 0.3) (-> tgt control ctrl-xz-vel))
                        (logtest? (-> tgt control status) (collide-status on-surface))
                        (-> tgt state) (= (-> tgt state name) 'target-walk)
                        )
                   1.0
                   0.0
                   )
               (* 4.0 (seconds-per-frame))
               )
        (when (!= out? (-> st was-out))
          (set! (-> st was-out) out?)
          (format 0 "[sig-gun] ~A~%" (if out? "out" "away"))
          )
        ;; where the barrel points: Jak's gun's fire direction (not behind him) by aim-weight, else ahead and
        ;; a little down
        (set! (-> fwd y) 0.0)
        (set! (-> fwd w) 0.0)
        (vector-normalize! fwd 1.0)
        (vector-copy! dir (if (nonzero? (-> tgt gun)) (-> tgt gun fire-dir-out) fwd))
        (set! (-> dir w) 0.0)
        ;; no target: level, as his shots go (gun-dark-shot.gc)
        (if (not (and (nonzero? (-> tgt gun)) (handle->process (-> tgt gun track-target 0 handle))))
            (set! (-> dir y) 0.0)
            )
        (if (or (< (vector-length dir) 0.5) (< (vector-dot dir fwd) (* 0.3 (vector-length dir))))
            (vector-copy! dir fwd)
            )
        (vector-normalize! dir 1.0)
        (let ((low (vector-copy! (new 'stack-no-clear 'vector) fwd)))
          (set! (-> low y) -0.25)
          (vector-normalize! low 1.0)
          (vector-lerp! dir low dir (-> st aim-weight))
          (vector-normalize! dir 1.0)
          )
        ;; (his rest and walking arms let go as fast as Jak's attack arms come in: left to their own
        ;; 0.2-0.25 s they held his right arm back for most of a punch)
        (let* ((att (- 1.0 *enhanced-sig-attack-weight*))
               (out-w (* (-> st out-blend) att))
               (two-w (* (fmin *enhanced-sig-two-weight* (-> st out-blend)) att))
               (rest-w (* (-> st rest-weight) att))
               (calm-w (* *enhanced-sig-calm-weight* att))
               )
          (if (or (< 0.0 out-w) (< 0.0 rest-w))
              (enhanced-sig-hold-pose out-w rest-w)
              )
          (if (< 0.0 calm-w)
              (enhanced-sig-calm-arms calm-w)
              )
          (if (< 0.0 two-w)
              (enhanced-sig-two-hand! two-w dir)
              )
          ;; attacking with it out: in his right hand as he grips it
          (when (and (< 0.0 (-> st out-blend)) (< 0.0 *enhanced-sig-attack-weight*))
            (let ((g (enhanced-sig-grip! (new 'stack-no-clear 'matrix)))
                  (m (-> self node-list data SIG_GUN bone transform))
                  )
              (enhanced-matrix-blend-rows! m m g (* (-> st out-blend) *enhanced-sig-attack-weight*) m)
              (matrix*! (-> self node-list data SIG_BLAST bone transform) (-> st blast-local) m)
              )
            )
          )
        ;; Jak's shots leave from its muzzle, along its barrel
        (cond
          ((< 0.5 (-> st out-blend))
           (vector-copy! *enhanced-big-gun-muzzle* (-> self node-list data SIG_BLAST bone transform trans))
           (set! *enhanced-big-gun-pid* (-> self pid))
           )
          (else
            (set! *enhanced-big-gun-pid* 0)
            )
          )
        (if (and *enhanced-sig-gun-test* (< 0.5 (-> st aim-weight)) (zero? (mod (-> st test-frame) 30)))
            (format 0 "[sig-gun] aim ~,,2f two ~,,2f gun-along-shot ~,,2f~%" (-> st aim-weight) *enhanced-sig-two-weight*
                    (vector-dot dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> self node-list data SIG_GUN bone transform fvec) 1.0))
                    )
            )
        )
      )
    )
  (none)
  )
