;;-*-Lisp-*-
(in-package goal)

;; name: enhanced-ashelin-kick.gc
;; name in dgo: enhanced-ashelin-kick
;; dgos: GAME

;; Enhanced: Ashelin's front kick, in place of Jak's punch (square, standing or running) while she is the
;; player's model (enhanced-player.gc). Her art group (ashelin-ag) has no kick and Jak's attacks are a spin
;; kick and punches, so it comes from motion capture: ACCAD's "Male 2 Martial Arts Kicks", front kick
;; (Motion capture: ACCAD, The Ohio State University, CC BY 3.0). From its markers (C3D) a script derived
;; joint centres and, at 30 samples a second over 0.7 s (the kick from the stance to the foot back down),
;; the direction of each of her posed bones (toward its child joint), in the kicker's model space (+z
;; forward, +y up, +x his left), plus his pelvis's tilt, turn and height. Each sample: 12 directions (the
;; bones below), pelvis up, pelvis forward, pelvis height change (fraction of his hip height). Only these
;; derived numbers are here, not the capture. Her bones are aimed along them on top of her idle (what
;; hangs from a bone follows it), so it doesn't depend on her joints' own axes or her proportions.
;; Jak's target (hidden) runs target-enhanced-kick: his punch's events and surface, a small step forward
;; (about 0.7 m), and the punch's damage ('punch: same attack, same reactions) only while the leg is out,
;; from a sphere on her kicking foot. Out of the punch, the running punch (same state, square while
;; running) kicks too; the dive (square in the air) and the spin kick (circle) stay Jak's.
;; *enhanced-ashelin-kick-freeze* (REPL, seconds into the kick, -1 off): holds the pose at that point (for
;; screenshots); the hit sphere follows it.

(define *enhanced-ashelin-kick-phase* -1.0)   ;; seconds into the kick now, -1: not kicking
(define *enhanced-ashelin-kick-freeze* -1.0)
(define *enhanced-ashelin-kick-start* (new 'global 'vector)) ;; where Jak stood when it began
(define *enhanced-ashelin-kick-log* 0)

(defconstant ASHELIN_KICK_LENGTH 0.7)  ;; seconds
(defconstant ASHELIN_KICK_HIT_FROM 0.22)
(defconstant ASHELIN_KICK_HIT_TO 0.48)

(defun enhanced-ashelin-kick-active? ()
  "Is Ashelin kicking now (her pose comes from this file)?"
  (and (<= 0.0 *enhanced-ashelin-kick-phase*) (enhanced-player-ashelin?))
  )

;; The bones posed, in the table's order: each one's joint and the joint its direction points to.
(defconstant ASHELIN_KICK_AIMS 12)
(define *enhanced-ashelin-kick-joints* (new 'static 'array int32 24
  4 5     ;; chest -> neck
  5 6     ;; neck -> head
  7 8     ;; left upper arm
  8 9     ;; left forearm
  10 11   ;; right upper arm
  11 12   ;; right forearm
  14 15   ;; left thigh (the standing leg)
  15 16   ;; left shin
  18 19   ;; right thigh (the kick)
  19 20   ;; right shin
  20 21   ;; right foot
  16 17   ;; left foot
  ))

(defconstant ASHELIN_KICK_SAMPLES 22)   ;; 0-0.7 s
(defconstant ASHELIN_KICK_RATE 30.0)    ;; samples a second
(defconstant ASHELIN_KICK_STRIDE 43)    ;; floats a sample
