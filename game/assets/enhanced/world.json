// Enhanced: the world's look and weather for the three games, one file for all of them.
// Read by EnhancedPost (game/graphics/opengl_renderer/EnhancedPost.cpp) and reloaded while the game
// runs whenever this file is saved: edit, save, look.
// Check it against the games' levels with: python scripts/enhanced/check_games.py
{
  // per game: the bounced light (GI) and the lamps' strength (Jak 2's levels are lit brighter and
  // its neon is stronger; Jak 1 is saturated already)
  "tuning": {
    "jak1": {"gi": 0.6, "lamps": 1.0},
    "jak2": {"gi": 0.6, "lamps": 0.45},
    "jak3": {"gi": 1.0, "lamps": 1.0}
  },

  // per game: which zone a level is in, from the start of its name (the first match wins; no
  // match: "other")
  "levels": {
    "jak1": [
      {"zone": "islands", "prefixes": ["village1", "village2", "beach", "training", "intro", "rolling", "title", "demo"]},
      {"zone": "jungle", "prefixes": ["jungle"]},
      {"zone": "swamp", "prefixes": ["swamp"]},
      {"zone": "misty", "prefixes": ["misty"]},
      {"zone": "snow", "prefixes": ["snow"]},
      {"zone": "volcano", "prefixes": ["firecanyon", "village3", "lavatube", "ogre"]},
      {"zone": "under", "prefixes": ["sunken", "maincave", "darkcave", "robocave"]},
      {"zone": "temple", "prefixes": ["citadel", "finalboss"]}
    ],
    "jak2": [
      {"zone": "forest", "prefixes": ["for", "lfor"]},
      {"zone": "metalhead", "prefixes": ["mhc", "nst", "lmh", "nes"]},
      {"zone": "haven", "prefixes": ["cty", "lcty", "hiphog", "gungame", "freehq", "onintent", "vinroom", "piazza", "stadium", "intp", "kiosk", "oracle", "pal", "hide"]},
      {"zone": "desert", "prefixes": ["was", "lwas", "des", "wca", "wcb", "hang", "arena", "str", "dig"]},
      {"zone": "under", "prefixes": ["sew", "fact", "mine", "tow", "rail", "prec", "comb", "drill", "und", "cas"]},
      {"zone": "volcano", "prefixes": ["vol"]},
      {"zone": "temple", "prefixes": ["temp", "tomb"]},
      {"zone": "wilds", "prefixes": ["ruins", "mountain", "mtnext", "mincan", "consite", "sagehut", "skatea", "atoll"]},
      {"zone": "under", "prefixes": ["prison", "throne", "garage", "castle"]}
    ],
    "jak3": [
      {"zone": "forest", "prefixes": ["for", "lfor"]},
      {"zone": "metalhead", "prefixes": ["mhc", "nst", "lmh", "nes"]},
      {"zone": "haven", "prefixes": ["cty", "lcty", "hiphog", "gungame", "freehq", "onintent", "vinroom", "piazza", "stadium", "intp", "kiosk", "oracle", "pal", "hide"]},
      {"zone": "desert", "prefixes": ["was", "lwas", "des", "wca", "wcb", "hang", "arena", "str", "dig"]},
      {"zone": "under", "prefixes": ["sew", "fact", "mine", "tow", "rail", "prec", "comb", "drill", "und", "cas"]},
      {"zone": "volcano", "prefixes": ["vol"]},
      {"zone": "temple", "prefixes": ["temp", "tomb"]}
    ]
  },

  // the zones. "day" and "night" are the grade (eased between at dusk and dawn):
  //   lift: added in the shadows (rgb), gain: times the highlights (rgb), saturation (times the
  //   setting), contrast and warmth (plus the setting), clouds: the sky cover (0..1)
  // "weather" is what the "Changing" weather does there (all optional):
  //   outdoors: false = no weather at all (caves, interiors)
  //   rain, mist, snow, heat (hot air over lava), dust, sunny (the bright summer look),
  //   clouds (at least): always there
  //   harder: added on top for a while in every four-minute cycle (between harder_from and
  //     harder_to seconds of it)
  //   wet: how wet the ground is (default: as wet as it rains)
  //   showers: spells of weather, each "period" seconds long and each its own: with "chance" a
  //     spell brings rain (clouds build, rain, the sun out on the wet ground, drying), with
  //     "thunder" (of those) a thunderstorm; the rest are fair with clouds passing
  //   morning_mist: fog on early mornings (5 to 9)
  //   game_dust: the game's own sandstorms blow the dust up too
  "zones": {
    "other": {
      "day": {"lift": [0, 0, 0], "gain": [1, 1, 1], "saturation": 1.0, "contrast": 0.0, "warmth": 0.0, "clouds": 0.4},
      "night": {"lift": [0, 0, 0.012], "gain": [1, 1, 1.02], "saturation": 1.0, "contrast": 0.02, "warmth": 0.0, "clouds": 0.4},
      "weather": {}
    },
    // Haven: teal shadows and warm light by day; blue night, neon kept vivid
    "haven": {
      "day": {"lift": [-0.005, 0, 0.012], "gain": [1.03, 1, 0.96], "saturation": 1.0, "contrast": 0.04, "warmth": 0.02, "clouds": 0.5},
      "night": {"lift": [0, 0.006, 0.03], "gain": [1.06, 0.98, 1.02], "saturation": 1.12, "contrast": 0.08, "warmth": -0.02, "clouds": 0.65},
      "weather": {"showers": {"period": 240, "chance": 1.0, "thunder": 1.0}, "sunny": 1.0, "morning_mist": 0.6}
    },
    // desert: sun-baked by day, cold blue night
    "desert": {
      "day": {"lift": [0.01, 0.004, -0.006], "gain": [1.05, 1, 0.91], "saturation": 1.04, "contrast": 0.05, "warmth": 0.04, "clouds": 0.2},
      "night": {"lift": [0, 0.004, 0.02], "gain": [0.98, 0.98, 1.05], "saturation": 0.95, "contrast": 0.04, "warmth": -0.03, "clouds": 0.25},
      "weather": {"dust": 0.15, "harder": {"dust": 0.65}, "harder_from": 120, "harder_to": 210, "game_dust": true}
    },
    // forest: autumn gold, a little green in the shade
    "forest": {
      "day": {"lift": [0, 0.008, 0.004], "gain": [1.07, 1, 0.86], "saturation": 1.12, "contrast": 0.06, "warmth": 0.03, "clouds": 0.45},
      "night": {"lift": [0, 0.006, 0.022], "gain": [0.98, 1, 1.04], "saturation": 1.0, "contrast": 0.05, "warmth": -0.02, "clouds": 0.5},
      "weather": {"showers": {"period": 240, "chance": 1.0, "thunder": 1.0}, "sunny": 1.0, "morning_mist": 1.0}
    },
    // Metal Heads: sickly purple shadows
    "metalhead": {
      "day": {"lift": [0.012, 0, 0.02], "gain": [1, 0.96, 1.04], "saturation": 1.08, "contrast": 0.08, "warmth": 0.0, "clouds": 0.6},
      "night": {"lift": [0.012, 0, 0.026], "gain": [1, 0.96, 1.06], "saturation": 1.1, "contrast": 0.09, "warmth": -0.01, "clouds": 0.6},
      "weather": {"outdoors": false}
    },
    // underground (sewers, factory, mines, tower, caves, the sunken city): cool and contrasty
    "under": {
      "day": {"lift": [-0.004, 0.002, 0.012], "gain": [1, 1, 1.02], "saturation": 0.94, "contrast": 0.1, "warmth": -0.01, "clouds": 0.4},
      "night": {"lift": [-0.004, 0.002, 0.012], "gain": [1, 1, 1.02], "saturation": 0.94, "contrast": 0.1, "warmth": -0.01, "clouds": 0.4},
      "weather": {"outdoors": false}
    },
    // volcano: hot, the air shimmering over the lava
    "volcano": {
      "day": {"lift": [0.015, 0, -0.005], "gain": [1.08, 0.96, 0.85], "saturation": 1.1, "contrast": 0.08, "warmth": 0.04, "clouds": 0.5},
      "night": {"lift": [0.015, 0, 0], "gain": [1.06, 0.95, 0.9], "saturation": 1.08, "contrast": 0.08, "warmth": 0.02, "clouds": 0.5},
      "weather": {"outdoors": false, "heat": 1.0}
    },
    // temples: golden
    "temple": {
      "day": {"lift": [0.006, 0.004, 0], "gain": [1.04, 1.02, 0.92], "saturation": 1.04, "contrast": 0.06, "warmth": 0.02, "clouds": 0.4},
      "night": {"lift": [0, 0.004, 0.018], "gain": [1, 1, 1.03], "saturation": 1.0, "contrast": 0.05, "warmth": -0.01, "clouds": 0.4},
      "weather": {"outdoors": false}
    },
    // Jak 2's wilds outside Haven (Dead Town, the mountain, the atoll, the construction site):
    // grey-green, showers come over now and then
    "wilds": {
      "day": {"lift": [0, 0.006, 0.01], "gain": [1.01, 1.02, 0.98], "saturation": 0.98, "contrast": 0.06, "warmth": 0.0, "clouds": 0.5},
      "night": {"lift": [0, 0.006, 0.026], "gain": [0.97, 0.99, 1.05], "saturation": 0.95, "contrast": 0.06, "warmth": -0.03, "clouds": 0.55},
      "weather": {"showers": {"period": 360, "chance": 0.6, "thunder": 0.4}, "sunny": 0.4, "morning_mist": 0.8}
    },
    // Jak 1's islands (Sandover, the beach, the hills): bright and warm, blue night. Ten-minute
    // spells: mostly fair, some with a shower, a few with a thunderstorm. The game is saturated
    // already: only a touch of the sunny look
    "islands": {
      "day": {"lift": [0.004, 0.008, 0.016], "gain": [1.02, 1.01, 0.98], "saturation": 1.0, "contrast": 0.04, "warmth": 0.02, "clouds": 0.2},
      "night": {"lift": [0, 0.006, 0.03], "gain": [0.98, 1, 1.05], "saturation": 1.0, "contrast": 0.05, "warmth": -0.02, "clouds": 0.35},
      "weather": {"showers": {"period": 600, "chance": 0.55, "thunder": 0.45}, "sunny": 0.3, "morning_mist": 0.5}
    },
    // the jungle: deep greens, the rain comes often
    "jungle": {
      "day": {"lift": [0, 0.01, 0.004], "gain": [1.02, 1.04, 0.94], "saturation": 1.1, "contrast": 0.06, "warmth": 0.02, "clouds": 0.5},
      "night": {"lift": [0, 0.006, 0.022], "gain": [0.98, 1, 1.04], "saturation": 1.0, "contrast": 0.05, "warmth": -0.02, "clouds": 0.5},
      "weather": {"showers": {"period": 300, "chance": 0.8, "thunder": 0.5}, "sunny": 0.3, "morning_mist": 1.0}
    },
    // Boggy Billy's swamp: it always rains, harder now and then, under a low fog
    "swamp": {
      "day": {"lift": [0.004, 0.008, 0.004], "gain": [0.98, 1, 0.94], "saturation": 0.88, "contrast": 0.04, "warmth": 0.0, "clouds": 0.75},
      "night": {"lift": [0, 0.006, 0.02], "gain": [0.96, 0.98, 1.02], "saturation": 0.9, "contrast": 0.05, "warmth": -0.02, "clouds": 0.75},
      "weather": {"rain": 0.6, "mist": 0.6, "wet": 1.0, "harder": {"rain": 0.4}, "harder_from": 60, "harder_to": 180}
    },
    // Misty Island: the fog never lifts, a drizzle now and then
    "misty": {
      "day": {"lift": [0.004, 0.008, 0.004], "gain": [0.98, 1, 0.94], "saturation": 0.88, "contrast": 0.04, "warmth": 0.0, "clouds": 0.75},
      "night": {"lift": [0, 0.006, 0.02], "gain": [0.96, 0.98, 1.02], "saturation": 0.9, "contrast": 0.05, "warmth": -0.02, "clouds": 0.75},
      "weather": {"mist": 0.9, "wet": 0.4, "harder": {"rain": 0.4, "wet": 0.6}, "harder_from": 60, "harder_to": 160}
    },
    // Snowy Mountain: cold, blue shadows; it always snows, harder now and then
    "snow": {
      "day": {"lift": [0, 0.006, 0.02], "gain": [1, 1.02, 1.06], "saturation": 0.95, "contrast": 0.05, "warmth": -0.04, "clouds": 0.6},
      "night": {"lift": [0, 0.006, 0.035], "gain": [0.97, 0.99, 1.06], "saturation": 0.92, "contrast": 0.06, "warmth": -0.05, "clouds": 0.6},
      "weather": {"snow": 0.55, "mist": 0.35, "clouds": 0.8, "harder": {"snow": 0.45, "mist": 0.25}, "harder_from": 90, "harder_to": 200}
    }
  }
}
