;; Playable characters' animation review watcher (Jak 3). REPL only: never part of the build.
;; Load it into a running test game through the dev goalc (seq.py --load, or dev_goalc -Eval of this file as
;; one form with the ;; comments stripped). A process in *display-pool* then logs one "[ca]" line per state
;; of Jak (and per tag of a pad sequence), with numbers about the drawn skin (S) against Jak himself (J):
;;   foot  lowest ankle against its bind height on the ground, min/mean (cm); slide = the planted foot's
;;         ground speed (m/s)
;;   pop   largest second difference of main, head, hands, feet (cm a frame squared): a joint that jumps
;;   rows  the mapped bones' shortest and longest matrix row; skew = how far from square (sheared bones)
;;   dots  in Jak's pose: upper arms, forearms, thighs, shins (L R) and spine along Jak's (1 = the same)
;;   hsp   a hand's shortest distance to the spine (cm): hands inside the body
;;   veh   riding: hands, feet, head height and hips against Jak's (cm)
;; "[ca] POP" lines (when *ca-verbose*) name single frames. Pad sequences: (ca-q frame op arg) ... (ca-go),
;; ops in seq.py; *ca-freeze-state* / *ca-freeze-frame* stop the game at a state's frame for a screenshot.
(begin
(define *ca-on* #t)
(define *ca-tag* 0)
(define *ca-state* (the-as symbol #f))
(define *ca-n* 0)
(define *ca-hist* 0)
(define *ca-acc* (new 'static 'array float 64))
(define *ca-prev* (new 'static 'inline-array vector 40))
(define *ca-jj* (new 'static 'array int32 6 3 8 19 28 41 47))
(define *ca-jl* (new 'static 'array int32 18 17 18 26 27 18 19 27 28 39 40 45 46 40 41 46 47 3 7))
(define *ca-sk* (new 'static 'array int32 64))
(define *ca-sk-pid* 0)
(define *ca-jfoot* -1)
(define *ca-sfoot* -1)
(define *ca-jbind* 0.0)
(define *ca-cam-on* #f)
(define *ca-cam-dot* -0.6)
(define *ca-freeze-state* (the-as symbol #f))
(define *ca-freeze-frame* 0.0)
(define *ca-ev* (new 'static 'array int32 600))
(define *ca-ev-n* 0)
(define *ca-ev-i* 0)
(define *ca-seq-t* -1)
(define *ca-verbose* #t)

(defun ca-cm ((x float)) (* x (/ 100.0 4096.0)))

(defun ca-acc-reset ()
  (dotimes (i 64) (set! (-> *ca-acc* i) 0.0))
  (set! (-> *ca-acc* 2) 1000000.0)
  (set! (-> *ca-acc* 4) 1000000.0)
  (set! (-> *ca-acc* 18) 1000000.0)
  (dotimes (i 9) (set! (-> *ca-acc* (+ 21 i)) 2.0))
  (set! (-> *ca-acc* 31) 1000000.0)
  (set! (-> *ca-acc* 32) 1000000.0)
  (set! *ca-n* 0)
  (none))

(defun ca-flush ()
  (when (> *ca-n* 0)
    (let ((a *ca-acc*) (n (the float *ca-n*)))
      (format 0 "[ca] t~D ~A n~D pb~,,2f" *ca-tag* *ca-state* *ca-n* (/ (-> a 0) n))
      (when (< 0.0 (-> a 1))
        (format 0 " | foot S~,,1f/~,,1f J~,,1f/~,,1f" (ca-cm (-> a 2)) (ca-cm (/ (-> a 3) (-> a 1))) (ca-cm (-> a 4)) (ca-cm (/ (-> a 5) (-> a 1))))
        (format 0 " slide S~,,2f J~,,2f"
                (if (< 0.0 (-> a 7)) (* 60.0 (/ 1.0 4096.0) (/ (-> a 6) (-> a 7))) 0.0)
                (if (< 0.0 (-> a 9)) (* 60.0 (/ 1.0 4096.0) (/ (-> a 8) (-> a 9))) 0.0)))
      (format 0 " | pop S~,,1f ~,,1f ~,,1f ~,,1f" (ca-cm (-> a 10)) (ca-cm (-> a 11)) (ca-cm (-> a 12)) (ca-cm (-> a 13)))
      (format 0 " J~,,1f ~,,1f ~,,1f ~,,1f" (ca-cm (-> a 14)) (ca-cm (-> a 15)) (ca-cm (-> a 16)) (ca-cm (-> a 17)))
      (format 0 " | rows ~,,2f ~,,2f skew ~,,2f" (-> a 18) (-> a 19) (-> a 20))
      (when (< 0.0 (-> a 30))
        (format 0 " | dots ~,,2f ~,,2f ~,,2f ~,,2f" (-> a 21) (-> a 22) (-> a 23) (-> a 24))
        (format 0 " ~,,2f ~,,2f ~,,2f ~,,2f ~,,2f" (-> a 25) (-> a 26) (-> a 27) (-> a 28) (-> a 29)))
      (format 0 " | hsp S~,,1f J~,,1f" (ca-cm (-> a 31)) (ca-cm (-> a 32)))
      (when (< 0.0 (-> a 36))
        (format 0 " | veh hand ~,,1f foot ~,,1f head ~,,1f hips ~,,1f" (ca-cm (-> a 33)) (ca-cm (-> a 34)) (ca-cm (/ (-> a 35) (-> a 36))) (ca-cm (-> a 37))))
      (format 0 "~%")))
  (ca-acc-reset)
  (none))

(defun ca-pos! ((out vector) (nl cspace-array) (j int) (org vector))
  (vector-! out (-> nl data j bone transform trans) org)
  (set! (-> out w) 1.0)
  out)

(defun ca-dir! ((out vector) (nl cspace-array) (a int) (b int))
  (vector-! out (-> nl data b bone transform trans) (-> nl data a bone transform trans))
  (set! (-> out w) 0.0)
  (vector-normalize! out 1.0))

(defun ca-d2 ((p vector) (p1 vector) (p2 vector))
  (let ((v (new 'stack-no-clear 'vector)))
    (vector-float*! v p1 -2.0)
    (vector+! v v p)
    (vector+! v v p2)
    (set! (-> v w) 0.0)
    (vector-length v)))

(defun ca-seg-dist ((p vector) (a vector) (b vector))
  (let* ((ab (vector-! (new 'stack-no-clear 'vector) b a))
         (ap (vector-! (new 'stack-no-clear 'vector) p a))
         (l2 (vector-dot ab ab))
         (t (if (< 0.0 l2) (fmax 0.0 (fmin 1.0 (/ (vector-dot ap ab) l2))) 0.0)))
    (vector+float*! ap ap ab (- t))
    (set! (-> ap w) 0.0)
    (vector-length ap)))

(defun ca-xz ((a vector) (b vector))
  (let ((dx (- (-> a x) (-> b x))) (dz (- (-> a z) (-> b z))))
    (sqrtf (+ (* dx dx) (* dz dz)))))

(defun ca-pop-slot ((i int))
  (cond ((= i 0) 0) ((= i 1) 1) ((< i 4) 2) (else 3)))

(defun ca-measure ((tgt target) (skin enhanced-skin))
  (let* ((a *ca-acc*)
         (jn (-> tgt node-list))
         (org (-> tgt control trans))
         (pv *ca-prev*)
         (p (new 'stack-no-clear 'vector))
         (q (new 'stack-no-clear 'vector))
         (m (new 'stack-no-clear 'matrix))
         (ground? (logtest? (-> tgt control status) (collide-status on-surface)))
         (hist? (>= *ca-hist* 2)))
    (when (= *ca-jbind* 0.0)
      (matrix-4x4-inverse! m (-> jn data 41 joint bind-pose))
      (set! *ca-jbind* (-> m trans y)))
    ;; Jak's tracked joints: pops (against his prejoint on foot: his root in a vehicle)
    (dotimes (i 6)
      (ca-pos! p jn (-> *ca-jj* i) (if (focus-test? tgt pilot pilot-riding edge-grab pole flut board mech tube) org (-> jn data 2 bone transform trans)))
      (when hist?
        (let ((d2 (ca-d2 p (-> pv (+ 12 i)) (-> pv (+ 18 i)))) (slot (+ 14 (ca-pop-slot i))))
          (set! (-> a slot) (fmax (-> a slot) d2))))
      (vector-copy! (-> pv (+ 18 i)) (-> pv (+ 12 i)))
      (vector-copy! (-> pv (+ 12 i)) p))
    ;; Jak's feet
    (let* ((yl (- (- (-> jn data 41 bone transform trans y) (-> org y)) *ca-jbind*))
           (yr (- (- (-> jn data 47 bone transform trans y) (-> org y)) *ca-jbind*))
           (foot (if (< yl yr) 41 47))
           (lo (fmin yl yr)))
      (when ground?
        (set! (-> a 4) (fmin (-> a 4) lo))
        (+! (-> a 5) lo)
        (when (and (= foot *ca-jfoot*) (< lo (meters 0.06)) hist?)
          (+! (-> a 8) (ca-xz (-> jn data foot bone transform trans) (-> pv 34)))
          (+! (-> a 9) 1.0)))
      (set! *ca-jfoot* foot)
      (vector-copy! (-> pv 34) (-> jn data foot bone transform trans)))
    ;; Jak's hands against his spine
    (set! (-> a 32) (fmin (-> a 32) (fmin (ca-seg-dist (-> jn data 19 bone transform trans) (-> jn data 38 bone transform trans) (-> jn data 7 bone transform trans))
                                           (ca-seg-dist (-> jn data 28 bone transform trans) (-> jn data 38 bone transform trans) (-> jn data 7 bone transform trans)))))
    (when skin
      (let ((sn (-> skin node-list))
            (sk *ca-sk*))
        (when (!= (-> skin pid) *ca-sk-pid*)
          (set! *ca-sk-pid* (-> skin pid))
          (dotimes (i 64) (set! (-> sk i) (enhanced-skin-joint-of skin i)))
          (set! *ca-hist* 0)
          (set! hist? #f))
        (+! (-> a 0) (-> skin pose-blend))
        ;; its tracked joints: pops
        (dotimes (i 6)
          (ca-pos! p sn (-> sk (-> *ca-jj* i)) org)
          (when hist?
            (let ((d2 (ca-d2 p (-> pv i) (-> pv (+ 6 i)))) (slot (+ 10 (ca-pop-slot i))))
              (set! (-> a slot) (fmax (-> a slot) d2))
              (when (and *ca-verbose* (< (if (< i 2) (meters 0.12) (meters 0.3)) d2))
                (format 0 "[ca] POP j~D ~,,1f cm ~A f~,,1f pb~,,2f anim ~D~%" i (ca-cm d2) (-> tgt state name)
                        (-> tgt skel root-channel 0 frame-num) (-> skin pose-blend) (-> skin anim)))))
          (vector-copy! (-> pv (+ 6 i)) (-> pv i))
          (vector-copy! (-> pv i) p))
        ;; its feet
        (let* ((kl (-> sk 41)) (kr (-> sk 47))
               (yl (- (- (-> sn data kl bone transform trans y) (-> org y)) (-> skin bind-world kl trans y)))
               (yr (- (- (-> sn data kr bone transform trans y) (-> org y)) (-> skin bind-world kr trans y)))
               (foot (if (< yl yr) kl kr))
               (lo (fmin yl yr)))
          (when ground?
            (+! (-> a 1) 1.0)
            (set! (-> a 2) (fmin (-> a 2) lo))
            (+! (-> a 3) lo)
            (when (and (= foot *ca-sfoot*) (< lo (meters 0.06)) hist?)
              (+! (-> a 6) (ca-xz (-> sn data foot bone transform trans) (-> pv 33)))
              (+! (-> a 7) 1.0)))
          (set! *ca-sfoot* foot)
          (vector-copy! (-> pv 33) (-> sn data foot bone transform trans)))
        ;; its bones' rows: lengths and skew, over the joints mapped to Jak's
        (let ((jmap (-> skin char joints)))
          (dotimes (k (min (-> jmap length) (-> sn length)))
            (when (>= (-> jmap k) 0)
              (let* ((b (-> sn data k bone transform))
                     (l0 (vector-length (-> b rvec))) (l1 (vector-length (-> b uvec))) (l2 (vector-length (-> b fvec))))
                (set! (-> a 18) (fmin (-> a 18) (fmin l0 (fmin l1 l2))))
                (set! (-> a 19) (fmax (-> a 19) (fmax l0 (fmax l1 l2))))
                (when (and (< 0.01 l0) (< 0.01 l1) (< 0.01 l2))
                  (set! (-> a 20) (fmax (-> a 20) (fabs (/ (vector-dot (-> b rvec) (-> b uvec)) (* l0 l1)))))
                  (set! (-> a 20) (fmax (-> a 20) (fabs (/ (vector-dot (-> b rvec) (-> b fvec)) (* l0 l2)))))
                  (set! (-> a 20) (fmax (-> a 20) (fabs (/ (vector-dot (-> b uvec) (-> b fvec)) (* l1 l2))))))))))
        ;; its limbs along Jak's (this frame's or last frame's), in his pose
        (dotimes (i 9)
          (let ((ja (-> *ca-jl* (* 2 i))) (jb (-> *ca-jl* (+ 1 (* 2 i)))))
            (ca-dir! p jn ja jb)
            (when (and hist? (>= (-> skin pose-blend) 0.99))
              (ca-dir! q sn (-> sk ja) (-> sk jb))
              (let ((d (fmax (vector-dot p q) (vector-dot (-> pv (+ 24 i)) q))))
                (set! (-> a (+ 21 i)) (fmin (-> a (+ 21 i)) d))))
            (vector-copy! (-> pv (+ 24 i)) p)))
        (if (and hist? (>= (-> skin pose-blend) 0.99)) (+! (-> a 30) 1.0))
        ;; its hands against its spine
        (set! (-> a 31) (fmin (-> a 31) (fmin (ca-seg-dist (-> sn data (-> sk 19) bone transform trans) (-> sn data (-> sk 38) bone transform trans) (-> sn data (-> sk 7) bone transform trans))
                                               (ca-seg-dist (-> sn data (-> sk 28) bone transform trans) (-> sn data (-> sk 38) bone transform trans) (-> sn data (-> sk 7) bone transform trans)))))
        ;; riding: its hands, feet, head and hips against Jak's
        (when (focus-test? tgt pilot flut board mech)
          (set! (-> a 33) (fmax (-> a 33) (fmax (vector-vector-distance (-> sn data (-> sk 19) bone transform trans) (-> jn data 19 bone transform trans))
                                                 (vector-vector-distance (-> sn data (-> sk 28) bone transform trans) (-> jn data 28 bone transform trans)))))
          (set! (-> a 34) (fmax (-> a 34) (fmax (vector-vector-distance (-> sn data (-> sk 41) bone transform trans) (-> jn data 41 bone transform trans))
                                                 (vector-vector-distance (-> sn data (-> sk 47) bone transform trans) (-> jn data 47 bone transform trans)))))
          (+! (-> a 35) (- (-> sn data (-> sk 8) bone transform trans y) (-> jn data 8 bone transform trans y)))
          (+! (-> a 36) 1.0)
          (set! (-> a 37) (fmax (-> a 37) (vector-vector-distance (-> sn data (-> sk 38) bone transform trans) (-> jn data 38 bone transform trans)))))
        ))
    (+! *ca-hist* 1)
    )
  (none))

(defun ca-hook ((k int))
  (format 0 "[ca] hook ~D~%" k)
  (none))

(defun ca-q ((t int) (op int) (arg int))
  (when (< *ca-ev-n* 200)
    (set! (-> *ca-ev* (* 3 *ca-ev-n*)) t)
    (set! (-> *ca-ev* (+ 1 (* 3 *ca-ev-n*))) op)
    (set! (-> *ca-ev* (+ 2 (* 3 *ca-ev-n*))) arg)
    (+! *ca-ev-n* 1))
  0)
(defun ca-reset () (set! *ca-ev-n* 0) (set! *ca-ev-i* 0) (set! *ca-seq-t* -1) 0)
(defun ca-go () (set! *ca-ev-i* 0) (set! *ca-seq-t* 0) 0)

(defun ca-seq-step ()
  (when (and (>= *ca-seq-t* 0) *target*)
    (while (and (< *ca-ev-i* *ca-ev-n*) (<= (-> *ca-ev* (* 3 *ca-ev-i*)) *ca-seq-t*))
      (let ((op (-> *ca-ev* (+ 1 (* 3 *ca-ev-i*))))
            (arg (-> *ca-ev* (+ 2 (* 3 *ca-ev-i*)))))
        (case op
          ((0) (ca-flush) (set! *ca-tag* arg))
          ((1) (set! *enhanced-pad-press* (the-as pad-buttons arg)))
          ((2) (set! *enhanced-pad-hold* (the-as pad-buttons arg)))
          ((3) (set! *enhanced-pad-lefty* arg))
          ((4) (set! *enhanced-pad-leftx* arg))
          ((5) (set! *enhanced-pad-rightx* arg))
          ((6)
           (format 0 "[ca] freeze ~D at seq ~D state ~A f ~,,1f~%" arg *ca-seq-t* (-> *target* state name) (-> *target* skel root-channel 0 frame-num))
           (set-master-mode 'freeze))
          ((7)
           (ca-flush)
           (set! *enhanced-pad-hold* (the-as pad-buttons 0))
           (set! *enhanced-pad-lefty* -1)
           (set! *enhanced-pad-leftx* -1)
           (set! *enhanced-pad-rightx* -1)
           (set! *ca-seq-t* -2)
           (format 0 "[ca] seq end~%"))
          ((8) (ca-hook arg))
          ((9) (set! *ca-cam-dot* (* 0.01 (the float arg))) (set! *ca-cam-on* #t))
          ))
      (+! *ca-ev-i* 1))
    (if (>= *ca-seq-t* 0) (+! *ca-seq-t* 1)))
  (none))

(defun ca-watch ()
  (let ((tgt *target*))
    (when (and tgt (= *master-mode* 'game))
      (when *ca-cam-on*
        (let* ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> tgt control quat)))
               (d (vector-dot fwd (-> *math-camera* inv-camera-rot fvec))))
          (cond
            ((< (fabs (- d *ca-cam-dot*)) 0.08)
             (set! *enhanced-pad-rightx* -1)
             (set! *ca-cam-on* #f)
             (format 0 "[ca] camera set, dot ~,,2f~%" d))
            (else (set! *enhanced-pad-rightx* 255)))))
      (when *ca-on*
        (let ((skin (the-as enhanced-skin (enhanced-skin-get)))
              (name (if (-> tgt state) (-> tgt state name) 'none)))
          (when (!= name *ca-state*)
            (ca-flush)
            (set! *ca-state* name))
          (ca-measure tgt skin)
          (+! *ca-n* 1)))
      (when (and *ca-freeze-state* (-> tgt state) (= (-> tgt state name) *ca-freeze-state*)
                 (>= (-> tgt skel root-channel 0 frame-num) *ca-freeze-frame*))
        (format 0 "[ca] frozen ~A f ~,,1f~%" *ca-freeze-state* (-> tgt skel root-channel 0 frame-num))
        (set! *ca-freeze-state* (the-as symbol #f))
        (set-master-mode 'freeze))
      (ca-seq-step)))
  (none))

(ca-acc-reset)
(if (not (process-by-name "ca-watch" *active-pool*))
    (process-spawn-function process (lambda :behavior process () (until #f (ca-watch) (suspend))) :name "ca-watch" :to *display-pool*))
0)
