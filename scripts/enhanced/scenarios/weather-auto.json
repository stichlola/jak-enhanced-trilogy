{
  "start": "desert-start",
  "headless": false,
  "env": { "JAK_ENHANCED_WEATHER": "1" },
  "timeout": 300,
  "variants": [
    { "name": "windy", "tune": { "weather": { "test_spell": 7, "test_strength": 0.6 } }, "timeout": 30,
      "expect": ["\\[enhanced\\] weather spell windy in des",
                 "\\[enhanced\\] wind now \\S+ \\(gust (1\\.[89]|[2-9]\\.)"] },
    { "name": "calm-1", "tune": { "weather": { "test_spell": 0, "test_strength": 0 } }, "timeout": 30,
      "expect": ["\\[enhanced\\] weather spell fair in des",
                 "\\[enhanced\\] wind now 0\\.[0-8]\\d "] },
    { "name": "sandstorm", "tune": { "weather": { "test_spell": 5, "test_strength": 0.6 } }, "timeout": 30,
      "expect": ["\\[enhanced\\] weather spell sandstorm in des",
                 "\\[enhanced\\] dust (0\\.[6-9]|1\\.\\d)",
                 "\\[enhanced\\] wind now \\S+ \\(gust (1\\.[89]|[2-9]\\.)"] },
    { "name": "calm-2", "tune": { "weather": { "test_spell": 0, "test_strength": 0 } }, "timeout": 30,
      "expect": ["\\[enhanced\\] wind now 0\\.[0-8]\\d "] },
    { "name": "thunder", "tune": { "weather": { "test_spell": 3, "test_strength": 0.6 } }, "timeout": 30,
      "expect": ["\\[enhanced\\] weather spell thunder in des",
                 "\\[enhanced\\] wind now \\S+ \\(gust (1\\.[5-9]|[2-9]\\.)\\d+, speed \\S+, rough (0\\.[5-9]|1\\.)"] },
    { "name": "fair", "tune": { "weather": { "test_spell": 0 } }, "timeout": 30,
      "expect": ["\\[enhanced\\] weather spell fair in des",
                 "\\[enhanced\\] wind now 0\\.[0-8]\\d "] },
    { "name": "fast-forward", "tune": { "weather": { "test_spell": -1, "time_scale": 40 } }, "settle": 60,
      "timeout": 5,
      "expect": ["\\[enhanced\\] weather spell \\w+ in \\w+ \\(zone [\\w-]+, strength \\d\\.\\d\\d, period \\d+ s\\)"] }
  ],
  "expect": ["\\[enhanced\\] world\\.json: \\d+ zones"],
  "forbid": ["\\[enhanced\\].*(failed|not loaded)", "\\[enhanced\\] world\\.json: .*unknown zone"]
}
