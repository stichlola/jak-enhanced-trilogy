{
  "start": "desert-start",
  "headless": false,
  "timeout": 120,
  "env": { "JAK_ENHANCED_WEATHER": "0", "JAK_ENHANCED_HOUR": "12" },
  "variants": [
    { "name": "wind-0.0", "wait": 2,
      "tune": { "debug": { "photo": 1, "view": [2262.49, 35.92, 246.27, 24.1, -6.7] },
                "weather": { "wind_force": 0.0 } },
      "settle": 8, "timeout": 20,
      "expect": ["\\[enhanced\\] wind now [\\d.]+ \\(gust 0\\.(3[5-9]|4\\d|5[0-5]),.*amount 0\\.0\\d\\)"] },
    { "name": "wind-0.15",
      "tune": { "debug": { "photo": 1, "view": [2262.49, 35.92, 246.27, 24.1, -6.7] },
                "weather": { "wind_force": 0.15 } },
      "settle": 8, "timeout": 20,
      "expect": ["\\[enhanced\\] wind now [\\d.]+ \\(gust 0\\.[5-8]\\d,.*amount 0\\.1\\d\\)"] },
    { "name": "wind-0.6",
      "tune": { "debug": { "photo": 1, "view": [2262.49, 35.92, 246.27, 24.1, -6.7] },
                "weather": { "wind_force": 0.6 } },
      "settle": 8, "timeout": 20,
      "expect": ["\\[enhanced\\] wind now [\\d.]+ \\(gust 1\\.[3-8]\\d,.*amount 0\\.[56]\\d\\)"] },
    { "name": "wind-1.2",
      "tune": { "debug": { "photo": 1, "view": [2262.49, 35.92, 246.27, 24.1, -6.7] },
                "weather": { "wind_force": 1.2 } },
      "settle": 8, "timeout": 20,
      "expect": ["\\[enhanced\\] wind now [\\d.]+ \\(gust (2\\.[4-9]|3\\.0)\\d,.*amount 1\\.[01]\\d\\)"] }
  ],
  "forbid": ["\\[enhanced\\].*(failed|not loaded)"]
}
